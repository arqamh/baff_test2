<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category for groups -->
    <record model="ir.module.category" id="finefinish_planning_access_category">
        <field name="name">Planning Special Access</field>
        <field name="sequence">2</field>
    </record>

    <!-- User groups -->
    <record id="group_lock_planning_tasks" model="res.groups">
        <field name="name">Permission to Lock Planning Slots</field>
        <field name="category_id" ref="finefinish_planning_access_category"/>
    </record>
    <record id="group_unlock_planning_tasks" model="res.groups">
        <field name="name">Permission to Unlock Planning Slots</field>
        <field name="category_id" ref="finefinish_planning_access_category"/>
    </record>
</odoo>
