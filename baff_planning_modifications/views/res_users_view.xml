<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="fine_finish_planning_modifications_res_users_view_form" model="ir.ui.view">
        <field name="name">fine.finish.planning.modifications.res.users.view.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_employee']" position="after">
                <field name="is_sales_rep" invisible="1"/>
                <field name="color_pick" widget="color_picker"/>
            </xpath>
        </field>
    </record>
</odoo>