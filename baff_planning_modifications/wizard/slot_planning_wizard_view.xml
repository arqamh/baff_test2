<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- wizard view-->
    <record id="slot_planning_wizard_tree_view" model="ir.ui.view">
        <field name="name">slot.planning.wizard.tree.view</field>
        <field name="model">slot.planning.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="slot_id"/>
                            <field name="resource_id"/>
                            <field name="role_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="operation_id" readonly="1"/>
                            <field name="work_center_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="allocated_hours"/>
                            <field name="prioritize"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Split Tasks">
                            <field name="task_lines">
                                <tree editable="bottom">
                                    <field name="task_line_id" invisible="1"/>
                                    <field name="resource_id"/>
                                    <field name="role_id"/>
                                    <field name="project_id" readonly="1"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="allocated_hours"/>
                                    <field name="prioritize"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--wizard action-->
    <record id="slot_planning_wizard_action" model="ir.actions.act_window">
        <field name="name">Split Tasks</field>
        <field name="res_model">slot.planning.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="slot_planning_wizard_tree_view"/>
        <field name="target">new</field>
    </record>
</odoo>
