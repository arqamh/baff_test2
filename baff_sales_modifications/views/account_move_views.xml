<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="baff_sales_modifications_view_invoice_form" model="ir.ui.view">
        <field name="name">baff.sales.modifications.view.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Invoiceable Lines">
                    <field name="invoiceable_line_ids">
                        <tree editable="bottom">
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="hs_code"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom"/>
                            <field name="price_unit"/>
                            <field name="tax_id" widget="many2many_tags" options="{'no_create': True}" context="{'search_view_ref': 'account.account_tax_view_search'}" domain="[('type_tax_use','=','sale'), ('company_id','=',parent.company_id)]"/>
                            <field name="price_subtotal"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']" position="attributes">
                <attribute name="string">Order Lines</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="po_reference" string="PO Reference"/>
            </xpath>
        </field>
    </record>
</odoo>