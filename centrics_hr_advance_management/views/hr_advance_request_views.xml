<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_advance_request_view_form" model="ir.ui.view">
        <field name="name">hr.advance.request.view.form</field>
        <field name="model">hr.advance.request</field>
        <field name="arch" type="xml">
            <form string="Advance Request">
                <header>
                    <field name="is_lines_generated" invisible="1"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" states="draft"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-success"
                            attrs="{'invisible': ['|',('is_lines_generated', '=', False),('state', '!=', 'submitted')]}"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" states="submitted"/>
                    <button name="action_paid" type="object" string="Mark as Paid" class="btn-secondary"
                            states="approved"/>

                    <button name="action_return" type="object" string="Return" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'paid')]}"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-warning"
                            states="submitted,approved,rejected"/>
                    <button name="action_generate_installment" type="object" string="Generate" class="btn-primary" states="submitted"/>
                    <field name="state" widget="statusbar" readonly="1"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name" placeholder="New"
                                   style="font-size: min(4vw, 2.6rem);" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Advance Request Information">
                        <group>
                            <field name="employee_id" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="contract_id" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="type_id" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="repayment_method" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="no_of_installments"
                                   attrs="{'readonly': [('state','=', 'submitted')], 'invisible': [('repayment_method', '!=', 'installments')], 'required':[('repayment_method', '=','installments')]}"/>
                        </group>
                        <group>
                            <field name="requested_amount" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="advance_expected_date" attrs="{'readonly': [('state','=', 'submitted')]}"/>
                            <field name="allowed_amount"/>
                            <field name="remaining_balance"/>
                            <field name="currency_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <group string="Back office Use">
                        <group>
                            <field name="processed_amount" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                            <field name="effective_year" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                            <field name="effective_month" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                            <field name="is_allowance" attrs="{'invisible': [('state', '=', 'draft')]}"/>
                        </group>
                        <group></group>

                    </group>
                    <group string="System Information" attrs="{'invisible': [('state', '=', 'draft')]}" >
                        <group>
                            <field name="submitted_date" attrs="{'invisible': [('state', '=', 'draft')]}" readonly="1"/>
                            <field name="submitted_user_id" attrs="{'invisible': [('state', '=', 'draft')]}" readonly="1"/>
                            <field name="approved_date" attrs="{'invisible': [('state', 'in', ['draft', 'submitted','rejected'])]}" readonly="1"/>
                            <field name="approved_user_id" attrs="{'invisible': [('state', 'in', ['draft','submitted', 'rejected'])]}" readonly="1"/>
                        </group>
                        <group>

                            <field name="rejected_date" attrs="{'invisible': [('state', 'not in', ['rejected'])]}" readonly="1"/>
                            <field name="rejected_user_id" attrs="{'invisible': [('state', 'not in', ['rejected'])]}" readonly="1"/>
                            <field name="paid_date" attrs="{'invisible': [('state', 'not in', ['paid'])]}" readonly="1"/>
                            <field name="paid_user_id" attrs="{'invisible': [('state', 'not in', ['paid'])]}" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Repayments" name="repayment_lines">
                            <field name="advance_installment_line_ids" readonly="1">
                                <tree>
                                    <field name="year"/>
                                    <field name="month"/>
                                    <field name="installment_amount"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Accounting Info" name="accounting_info">
                            <group>
                                <group>
                                    <field name="paid_journal_entry_id"/>
                                    <field name="returned_journal_entry_id"/>
                                </group>
                                <group></group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="message_follower_ids" widget="mail_followers"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hr_advance_request_view_tree" model="ir.ui.view">
        <field name="name">hr.advance.request.view.tree</field>
        <field name="model">hr.advance.request</field>
        <field name="arch" type="xml">
            <tree string="Advance Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="contract_id"/>
                <field name="type_id"/>
                <field name="requested_amount"/>
                <field name="allowed_amount"/>
                <field name="currency_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="hr_advance_request_action" model="ir.actions.act_window">
        <field name="name">Advance Requests</field>
        <field name="res_model">hr.advance.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hr_advance_request_action_menu"
              name="Advance Requests"
              parent="advance_management_menu_root"
              action="hr_advance_request_action"
              sequence="1"
    />
</odoo>