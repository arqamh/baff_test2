<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="baff_inventory_modification_product_template_form_view" model="ir.ui.view">
        <field name="name">baff.inventory.modification.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="string">Product Code</attribute>
            </xpath>
            <xpath expr="//field[@name='uom_po_id']" position="after">
                <field name="is_this_standard_bom"/>
                <field name="bom_type"/>
                <field name="boat_type_id" attrs="{'invisible': [('bom_type', '!=', 'base_bom')]}"/>
                <field name="boat_type_ids" attrs="{'invisible': [('bom_type', '!=', 'option_bom')]}" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <field name="last_purchase_price"/>
                <field name="last_purchase_date"/>
            </xpath>
            <xpath expr="//div[@name='options']" position="before">
                <group>
                    <group>
                        <field name="designation_2"/>
                    </group>
                    <group>
                        <field name="designation_3"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="clipper_no"/>
            </xpath>
            <xpath expr="//page[@name='inventory']//group[@name='group_lots_and_weight']" position="after">
                <group string="Boat Specifications">
                    <field name="length_overall"/>
                    <field name="maximum_beam"/>
                    <field name="draft"/>
                    <field name="standard_engine"/>
                    <field name="selected_capacity"/>
                    <field name="maximum_capacity"/>
                    <field name="color"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>