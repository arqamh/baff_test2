<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_boat_type_form" model="ir.ui.view">
        <field name="name">boat.type.form</field>
        <field name="model">boat.type</field>
        <field name="arch" type="xml">
            <form string="Boat Type">
                <sheet>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="name" placeholder="Boat Type" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="description"/>
                            <field name="length_overall"/>
                            <field name="maximum_beam"/>
                            <field name="draft"/>
                        </group>
                        <group>
                            <field name="standard_engine"/>
                            <field name="selected_capacity"/>
                            <field name="maximum_capacity"/>
                            <field name="color"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_boat_type_list" model="ir.ui.view">
        <field name="name">boat.type.list</field>
        <field name="model">boat.type</field>
        <field name="arch" type="xml">
            <tree default_order="name" editable="bottom">
                <field name="name" string="Boat Type" required="1"/>
                <field name="description" optional="show"/>
                <field name="company_id" invisible="1"/>
                <field name="length_overall"/>
                <field name="maximum_beam"/>
                <field name="draft"/>
                <field name="standard_engine"/>
                <field name="selected_capacity"/>
                <field name="maximum_capacity"/>
                <field name="color"/>
            </tree>
        </field>
    </record>

    <record id="action_boat_type" model="ir.actions.act_window">
        <field name="name">Boat Type</field>
        <field name="res_model">boat.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Boat Type" id="menu_boat_type" parent="stock.menu_product_in_config_stock" sequence="9" action="action_boat_type"/>
</odoo>