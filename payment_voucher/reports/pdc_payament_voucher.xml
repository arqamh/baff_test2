<?xml version="1.0"?>
<odoo>
    <template id="pdc_payment_voucher_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="header">
                        <p><center>
                            <span style="display:inline; font-size:14px;">

                                 <strong style="font-size:14px;"><span t-field="doc.company_id.name"/></strong>
                                  <span  t-if="doc.company_id.street"><br/><span t-field="doc.company_id.street"/></span>
                                  <span  t-if="doc.company_id.street2">, <span t-field="doc.company_id.street2"/></span>
                                  <span  t-if="doc.company_id.city">, <span t-field="doc.company_id.city"/></span>
                                  <span  t-if="doc.company_id.country_id"><br/><span t-field="doc.company_id.country_id"/></span>
                                  <span  t-if="doc.company_id.phone"><br/><span t-field="doc.company_id.phone"/>    | <span t-field="doc.company_id.email"/></span>
                              </span>
                            </center>
                            <center><strong style="display:inline; font-size:18px;">Payment Voucher</strong></center>
                        </p>
                    </div>
                    <div style="padding-top:10px">
                        <table width="100%" style="font-size:13px;">

                            <tr>
                                <td width="10%"></td>
                                <td width="5%"></td>
                                <td width="30%"></td>
                                <td width="5%"></td>
                                <td width="15%" style="border: solid 1px; padding-left:3px">Date</td>
                                <td width="35%" style="border: solid 1px; padding-left:3px"><span t-field="doc.cheque_date" t-options ='{"format": "dd/MM/yyyy"}'/></td>
                            </tr>
                            <tr>
                                <td><b>Payee</b></td>
                                <td class="text-center"><b>:</b></td>
                                <td style="border-bottom: solid 1px">&#160;<span t-field="doc.partner_id"/></td>
                                <td ></td>
                                <td style="border: solid 1px; padding-left:3px">Reference</td>
                                <td style="border: solid 1px; padding-left:3px"><span t-field="doc.name"/></td>
                            </tr>
                            <tr>
                                <td><b>Bank</b></td>
                                <td class="text-center"><b>:</b></td>
                                <td style="border-bottom: solid 1px">&#160;<span t-field="doc.journal_id"/></td>
                                <td></td>
                                <td style="border: solid 1px; padding-left:3px">Cheque No</td>
                                <td style="border: solid 1px; padding-left:3px"><span t-field="doc.reference"/></td>
                            </tr>
                            <tr>
                                <td><b>Remarks</b></td>
                                <td class="text-center"><b>:</b></td>
                                <td style="border-bottom: solid 1px">&#160;<span t-field="doc.memo"/></td>
                                <td></td>
                                <td style="border: solid 1px; padding-left:3px">Cheque Date</td>
                                <td style="border: solid 1px ; padding-left:3px"><span t-field="doc.cheque_date" t-options ='{"format": "dd/MM/yyyy"}' t-if="doc.cheque_date"/></td>
                            </tr>
                        </table>
                    </div>
                    <table style="border: solid 1px; width: 100%; height: 430px; margin-top: 15px; font-size:13px">
                        <thead>
                            <tr>
                                <th style="width: 40%; border-right: solid 1px; border-bottom: solid 1px;"><center>Memo</center></th>
                                <th style="width: 40%; border-right: solid 1px; border-bottom: solid 1px;"><center>Account</center></th>
                                <th style="width: 20%; border-bottom: solid 1px;"><center>Amount (<span t-field="doc.currency_id.symbol"/>)</center></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.payment_type=='send_money'">
                                <t t-foreach="doc.deposited_credit" t-as="payment">
                                    <tr>
                                        <td style="border-left: solid 1px; padding-left: 5px;">
                                            <span t-field="payment.name"/>
                                        </td>
                                        <td style="border-left: solid 1px; padding-left: 5px;">
                                            <span t-field="payment.account_id"/>
                                        </td>
                                        <td style="border-left: solid 1px; padding-right: 5px;" class="text-right">
                                            <span t-field="payment.credit" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="doc.deposited_debit" t-as="payment">
                                    <tr>
                                        <td style="border-left: solid 1px; padding-left: 5px;">
                                            <span t-field="payment.name"/>
                                        </td>
                                        <td style="border-left: solid 1px; padding-left: 5px;">
                                            <span t-field="payment.account_id"/>
                                        </td>
                                        <td style="border-left: solid 1px; padding-right: 5px;" class="text-right">
                                            <span t-field="payment.debit" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <tr>
                                <td style="border-left: solid 1px;"></td>
                                <!--<td></td>-->
                                <td style="border-left: solid 1px;"></td>
                                <td style="border-left: solid 1px;"></td>
                            </tr>
                        </tbody>
                    </table>
                    <br/>
                    <table width="100%" style="font-size:13px">

                        <tr>
                            <td width="23%" style="border: solid 1px; padding-left: 5px;" rowspan="2"><b>Amount in Words</b></td>
                            <td width="54.5%" rowspan="2" style="border: solid 1px;">&#160;<span t-esc="doc.currency_id.amount_to_text(doc.payment_amount or 0.00)"/></td>
                            <td width="2.5%"></td>
                            <td width="5%"><b>Total&#160;</b></td>
                            <td width="15%" class="text-right" style="border: solid 1px;; padding-right: 5px;"><span t-field="doc.payment_amount"/></td>
                        </tr>
                    </table>
                    <br/>
                    <br/>
                    <br/>
                    <table style="width: 100%; font-size:13px">
                        <tr>
                            <td class="text-center" style="width: 20%;">----------------------</td>
                            <td class="text-center" style="width: 20%;">----------------------</td>
                            <td class="text-center" style="width: 20%;">----------------------</td>
                            <td class="text-center" style="width: 20%;">----------------------</td>
                            <td class="text-center" style="width: 20%;">----------------------</td>
                        </tr>
                        <tr>
                            <td class="text-center" style="width: 20%;"><b>Prepared By</b></td>
                            <td class="text-center" style="width: 20%;"><b>Authorised By</b></td>
                            <td class="text-center" style="width: 20%;"><b>Received By</b></td>
                            <td class="text-center" style="width: 20%;"><b>Director</b></td>
                            <td class="text-center" style="width: 20%;"><b>Authorized Signatory</b></td>
                        </tr>
                    </table>

                </t>
            </t>
        </t>
    </template>


    <record id="action_pdc_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">pdc.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">payment_voucher.pdc_payment_voucher_report</field>
        <field name="report_file">payment_voucher.pdc_payment_voucher_report</field>
        <field name="binding_model_id" ref="sh_pdc.model_pdc_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="voucher_paperformat"/>
    </record>
</odoo>
