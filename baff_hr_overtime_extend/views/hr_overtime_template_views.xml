<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_overtime_template_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.overtime.template.view.form.inherit</field>
        <field name="model">hr.overtime.template</field>
        <field name="inherit_id" ref="centrics_hr_overtime.hr_overtime_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out_time']" position="after">
                <field name="non_working_day_start_time" widget="float_time"/>
            </xpath>
        </field>
    </record>
</odoo>
