        <field name="sequence">60</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if categories.GROSS > 0:
    result = ((BAS + BA)) * 0.12
        </field>
        <field name="struct_id" ref="hr_payroll_structure_ocean_voyager"/>
    </record>


<!--         ETF Contribution - Company -->
    <record id="rule_etf_contribution_company" model="hr.salary.rule">
        <field name="name">ETF Contribution - Company</field>
        <field name="code">ETFCOMP</field>
        <field name="sequence">61</field>
        <field name="category_id" ref="hr_payroll.COMP"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
if categories.GROSS > 0:
    result = ((BAS + BA)) * 0.03
        </field>
