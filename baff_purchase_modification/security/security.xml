<odoo>
    <record id="module_category_shipment_details" model="ir.module.category">
        <field name="name">Shipment Details
        </field>
        <field name="sequence">4</field>
    </record>
    <record id="group_shipment_details_user" model="res.groups">
        <field name="name">readonly</field>
        <field name="category_id" ref="module_category_shipment_details"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_shipment_details_user_manger" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_shipment_details"/>
        <field name="implied_ids" eval="[(4, ref('group_shipment_details_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>