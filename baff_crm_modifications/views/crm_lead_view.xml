<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="baff_crm_lead_form" model="ir.ui.view">
            <field name="name">baff.erp.crm.lead.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="inquiry_number"/>
                </xpath>
                 <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="after">
                     <field name="product_name" required="1"/>
                     <field name="boat_type_id" required="1"/>
                 </xpath>
                <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                    <attribute name='invisible'>1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_set_won_rainbowman']" position="before">
                    <button string="New Quotation" name="prepare_opportunity_quotation_context_unique" type="object" class="oe_highlight" data-hotkey="q"
                        title="Create new quotation"
                        attrs="{'invisible': ['|', ('type', '=', 'lead'), '&amp;', ('probability', '=', 0), ('active', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <record id="crm_lead_inquiry_number" model="ir.sequence">
            <field name="name">Inquiry Number</field>
            <field name="name">crm.lead</field>
            <field name="number_increment" eval="1"/>
        </record>
    </data>
</odoo>