<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--smart button to the open lead -->
        <record id="fine_finish_erp_crm_inquiry" model="ir.ui.view">
            <field name="name">fine.finish.erp.crm.inquiry</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                    <button name="open_lead" type="object" string="Inquiry" class="oe_stat_button" icon="fa-globe icon"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
