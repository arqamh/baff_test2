<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!-- Sequence (inquiry number) for crm lead -->
        <record id="seq_crm_lead" model="ir.sequence">
            <field name="name">Inquiry Number</field>
            <field name="code">inquiry.number</field>
            <field name="prefix">INQ</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
