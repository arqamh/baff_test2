<odoo>
    <record id="inherit_picking_remark_form_readonly" model="ir.ui.view">
            <field name="name">inherit.picking.form.readonly</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_validate']" position="attributes">
                    <attribute name="context">{'manual_validate': True}</attribute>
                </xpath>
                <xpath expr="//button[@name='button_validate'][2]" position="attributes">
                    <attribute name="context">{'manual_validate': True}</attribute>
                </xpath>

            </field>
    </record>
</odoo>