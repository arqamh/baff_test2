<odoo>
    <data>

        <record model="ir.ui.view" id="google_export_stats_list">
            <field name="name">Google Export Stats List</field>
            <field name="model">google.export.stats</field>
            <field name="arch" type="xml">
                <tree edit="false" create="false">
                    <field name="create_date" string="Sync Time"/>
                    <field name="new_contact" string="New Contacts"/>
                    <field name="new_calendar" string="New Events"/>
                    <field name="new_task" string="New Tasks"/>
                    <field name="upd_contact" string="Updated Contacts"/>
                    <field name="upd_calendar" string="New Events"/>
                    <field name="upd_task" string="New Tasks"/>
                    <field name="connector" widget="many2one"/>
                </tree>
            </field>
        </record>


        <record model="ir.actions.act_window" id="google_export_stats_action_window">
            <field name="name">Google Export History</field>
            <field name="res_model">google.export.stats</field>
            <field name="view_mode">tree</field>
        </record>

    </data>
</odoo>