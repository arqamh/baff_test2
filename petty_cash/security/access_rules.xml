<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="0">
        <!--   petty cash out own User     -->
        <record id="petty_cash_personal_cash_out" model="ir.rule">
            <field name="name">Petty cash Out: Own User</field>
            <field ref="model_petty_cash_out" name="model_id"/>
            <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own'))]"/>
        </record>
        <record id="petty_cash_personal_cash_iou_req" model="ir.rule">
            <field name="name">Petty cash IOU Request: Own User</field>
            <field ref="model_petty_cash_release" name="model_id"/>
            <field name="domain_force">['|',('user_id','=',user.id),('user_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own'))]"/>
        </record>
        <!--   petty cash out All User     -->
        <record id="petty_cash_all_user_cash_out" model="ir.rule">
            <field name="name">Petty cash Out: All User</field>
            <field ref="model_petty_cash_out" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_all'))]"/>
        </record>

        <record id="petty_cash_all_cash_iou_req" model="ir.rule">
            <field name="name">Petty cash IOU Request: All User</field>
            <field ref="model_petty_cash_release" name="model_id"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_all'))]"/>
        </record>
        <!--   petty cash out multi company rule     -->
        <record id="petty_cash_out_multi_company" model="ir.rule">
            <field name="name">petty Cash out Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_out"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_multi_company" model="ir.rule">
            <field name="name">petty Cash drawer Multi-Company</field>
            <field name="model_id" ref="model_petty_cash"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <!--   petty cash drawer lines summary multi company rule     -->
        <record id="petty_cash__lines_multi_company_rule" model="ir.rule">
            <field name="name">petty Cash drawer Lines Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_line"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <!--   petty cash in multi company rule     -->
        <record id="petty_cash_in_multi_company" model="ir.rule">
            <field name="name">petty Cash topup Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_in"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>
        <!--   petty cash IOU Request multi company rule     -->
        <record id="petty_cash_release_multi_company" model="ir.rule">
            <field name="name">petty Cash IOU Request Multi-Company</field>
            <field name="model_id" ref="model_petty_cash_release"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>

<!--    Remove noupdate attributes-->
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'petty_cash'), ('name', '=', 'petty_cash_all_user_cash_out')]" />
        </function>
        <value eval="{'noupdate': False}" />
    </function>
    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('module', '=', 'petty_cash'), ('name', '=', 'petty_cash_all_cash_iou_req')]" />
        </function>
        <value eval="{'noupdate': False}" />
    </function>


    <data>
         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_with_user_base" model="ir.rule">
            <field name="name">petty Cash drawer Only user base</field>
            <field name="model_id" ref="model_petty_cash"/>
            <field name="domain_force">['|',('user_id','=',user.id),('accessible_user_ids','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own'))]"/>
        </record>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_line_with_user_base" model="ir.rule">
            <field name="name">petty Cash drawer line Only user base</field>
            <field name="model_id" ref="model_petty_cash_line"/>
            <field name="domain_force">['|',('petty_cash_id.user_id','=',user.id),('petty_cash_id.accessible_user_ids','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own'))]"/>
        </record>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_in_with_user_base" model="ir.rule">
            <field name="name">petty Cash drawer top up Only user base</field>
            <field name="model_id" ref="model_petty_cash_in"/>
            <field name="domain_force">['|',('petty_cash_id.user_id','=',user.id),('petty_cash_id.accessible_user_ids','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own'))]"/>
        </record>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_all_cash_iou_req" model="ir.rule">
            <field name="name">petty Cash drawer IOU Only user base</field>
            <field name="model_id" ref="model_petty_cash_release"/>
            <field name="domain_force">['|',('petty_cash_id.user_id','=',user.id),('petty_cash_id.accessible_user_ids','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own')), (4, ref('petty_cash.petty_cash_group_user_all'))]"/>
        </record>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_all_user_cash_out" model="ir.rule">
            <field name="name">petty Cash drawer Reimbursement Only user base</field>
            <field name="model_id" ref="model_petty_cash_out"/>
            <field name="domain_force">['|',('petty_cash_id.user_id','=',user.id),('petty_cash_id.accessible_user_ids','in',user.id)]</field>
            <field name="groups" eval="[(4, ref('petty_cash.petty_cash_group_user_own')), (4, ref('petty_cash.petty_cash_group_user_all'))]"/>
        </record>
    </data>
    <data>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_with_user_base_admin" model="ir.rule">
            <field name="name">petty Cash drawer for all user</field>
            <field name="model_id" ref="model_petty_cash"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

         <!--   petty cash drawer multi company rule     -->
        <record id="petty_cash_summary_report_multi_company" model="ir.rule">
            <field name="name">petty Cash summary report -multi company</field>
            <field name="model_id" ref="model_reimbursement_summary_report"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>