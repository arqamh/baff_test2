<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="petty_iou_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">iou.confirmation.wizard.form</field>
        <field name="model">iou.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Approval">
                <sheet>
                    <div  class="alert alert-info text-center" role="status">
                        <h5>
                            <field name="message" nolabel="1" readonly="1" force_save="1"/>
                        </h5>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget='selection' invisible="1"/>
                            <field name="iou_request" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string='Yes' name="submission" context="{'keep_open':True}" type="object" class="btn-primary"/>
                    <button string='No' class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="petty_iou_confirmation_wizard_action" model="ir.actions.act_window">
        <field name="name">Confirmation</field>
        <field name="res_model">iou.confirmation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="petty_iou_confirmation_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>