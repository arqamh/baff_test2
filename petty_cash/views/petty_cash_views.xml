<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_petty_cash_filter" model="ir.ui.view">
            <field name="name">petty.cash.search</field>
            <field name="model">petty.cash</field>
            <field name="arch" type="xml">
                <search string="Petty Cash">
                    <field name="name" string="Name" filter_domain="['|',('name', 'ilike', self),('journal_id', 'ilike', self)]"/>
                    <field name="journal_id"/>
                    <field name="state"/>
                    <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]" />
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                    <filter string="Completed" name="completed" domain="[('state', '=', 'complete')]" />
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Journal" name="journal" domain="[]" context="{'group_by': 'journal_id'}"/>
                        <filter string="Status" name="status" domain="[]" context="{'group_by': 'state'}"/>
                    </group>
                </search>
             </field>
        </record>

        <record id="view_petty_cash_form" model="ir.ui.view">
            <field name="name">petty.cash.form</field>
            <field name="model">petty.cash</field>
            <field name="arch" type="xml">
                <form string="Petty Cash" >
                    <header>
                        <field name="is_available_topup" invisible="1"/>
                        <button name="button_confirm_petty_cash" type="object" string="Confirm" class="oe_highlight" groups="petty_cash.petty_cash_group_manager" attrs="{'invisible':[('state','!=','draft')]}"/>
                        <button name="button_petty_cash_in" type="object" string="Top Up"  attrs="{'invisible':['|', ('state','!=','in_progress'), ('is_available_topup', '!=', True)]}"/>
                        <button name="button_petty_cash_iou_request" type="object" string="IOU Request" class="oe_highlight" attrs="{'invisible':[('state','!=','in_progress')]}"/>
                        <button name="button_petty_reimbursement" type="object" string="Reimbursement" class="oe_highlight" attrs="{'invisible':[('state','!=','in_progress')]}"/>
                        <button name="%(petty_cash.increase_petty_cash_float_wizard_action)d" type="action" string="Increased Cash Float"  confirm="Are you sure to increased the cash float ?" groups="petty_cash.petty_cash_group_director" attrs="{'invisible':[('state','!=','in_progress')]}" context="{'cash_float_amount': petty_cash_float}"/>
                        <button name="button_petty_cash_complete" type="object" string="Complete"  groups="petty_cash.petty_cash_group_manager" confirm="Are you sure to close this cash drawer?" attrs="{'invisible':[('state','!=','in_progress')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,complete"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <field name="move_id"  invisible="1"   />
                            <field name="cash_issue_line_ids"  invisible="1"   />
                            <field name="cash_out_line_ids"  invisible="1"   />
                            <field name="cash_in_line_ids"  invisible="1"   />
                            <button name="button_view_journal_entries" icon="fa-bar-chart-o" class="oe_stat_button" string="Journal Entries" type="object" attrs="{'invisible':['|',('state','=','draft'),('move_id', '=',[])]}" />
                            <button name="action_button_petty_cash_in" icon="fa-usd" class="oe_stat_button" string="Top Up(s)" type="object" attrs="{'invisible':['|',('state','=','draft'),('cash_in_line_ids', '=',[])]}"/>
                            <button name="action_button_iou_requests" icon="fa-usd" class="oe_stat_button" string="IOU Request(s)" type="object" attrs="{'invisible':['|',('state','=','draft'),('cash_issue_line_ids', '=',[])]}"/>
                            <button name="action_button_reimbursement" icon="fa-usd" class="oe_stat_button" string="Reimbursement(s)" type="object" attrs="{'invisible':['|',('state','=','draft'),('cash_out_line_ids', '=',[])]}"/>
                        </div>
                        <div class="oe_title">
                            <h1 class="d-flex">
                                <field name="name" placeholder="Name" readonly="0" force_save="1" attrs="{'readonly':[('state','=','complete')]}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="start_date" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="journal_id" options="{'no_create': True, 'no_create_edit':True }" />
                                <field name="cash_flow" invisible="1" force_save="1"   />
                                <field name="cash_out" invisible="1" force_save="1" />
                                <field name="petty_cash_float" attrs="{'readonly':[('state','!=','draft')]}" />
                                <field name="cash_balance" readonly="1" force_save="1" attrs="{'invisible':[('state','in',('draft','complete'))]}"/>
                                <field name="is_transferred" invisible="1" />

                            </group>
                            <group>
                                <field name="end_date" attrs="{'readonly':[('state','!=','draft')]}"/>
                                <field name="user_id"  force_save="1" attrs="{'readonly':[('state','!=','draft')]}" options="{'no_create': True, 'no_create_edit':True }"/>
                                <field name="accessible_user_ids" force_save="1" attrs="{'readonly':[('state', '!=', 'draft')]}"  widget="many2many_tags" options="{'no_create': True, 'no_create_edit':True }"/>
                                <field name="currency_id" invisible="1" />
                                <field name="company_id" readonly="1" force_save="1" invisible="1" options="{'no_create': True, 'no_create_edit':True }"/>
                                <field name="sequence_prefix" force_save="1" attrs="{'readonly':[('sequence_prefix', '!=', False)]}"/>
                                <field name="sequence_format"  invisible="1"/>
                                <field name="iou_sequence_id"  invisible="1"/>
                                <field name="rem_sequence_id"  invisible="1"/>
                                <field name="topup_sequence_id"  invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Transactions" attrs="{'invisible':[('state','=','draft')]}">
                                <field name="petty_cash_line_ids" readonly="1">
                                    <tree decoration-info="cash_release_id != False" decoration-warning="petty_cash_in != False" decoration-success="cash_reimbursement_id != False" create="false">
                                        <field name="name" />
                                        <field name="from_acc" />
                                        <field name="to_acc" />
                                        <field name="reason" optional="hide"/>
                                        <field name="amount" />
                                        <field name="transfer_type" optional="hide"/>
                                        <field name="status" />
                                        <field name="employee_id" optional="hide"/>
                                        <field name="user_id" optional="hide"/>
                                        <field name="approved_by" optional="hide"/>
                                        <field name="petty_cash_id"  invisible="1"/>
                                        <field name="petty_cash_in"  invisible="1"/>
                                        <field name="cash_release_id"  invisible="1"/>
                                        <field name="cash_reimbursement_id"  invisible="1"/>
                                        <button name="button_view_line_details" type="object" string="View Details" class="btn btn-info" attrs="{'invisible': [('transfer_type','=', 'cash drawer')]}"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Fields only view in specific administrator -->
        <record id="view_petty_cash_form_inherit_for_admin" model="ir.ui.view">
            <field name="name">petty.cash.form</field>
            <field name="model">petty.cash</field>
            <field name="inherit_id" ref="petty_cash.view_petty_cash_form"/>
<!--            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>-->
            <field name="arch" type="xml">
                <xpath expr="//field[@name='accessible_user_ids']" position="attributes">
                    <attribute name="attrs">{'readonly':[('state','in',('complete', 'balance'))]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_petty_cash_tree" model="ir.ui.view">
            <field name="name">petty.cash.tree</field>
            <field name="model">petty.cash</field>
            <field name="arch" type="xml">
                <tree string="Petty cash" >
                    <field name="name" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="cash_flow" />
                    <field name="cash_out" />
                    <field name="cash_balance" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <!--  petty cash kanban view  -->
        <record model="ir.ui.view" id="view_petty_cash_kanban">
            <field name="name">petty.cash.kanban</field>
            <field name="model">petty.cash</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="cash_balance"/>
                    <field name="cash_flow"/>
                    <field name="cash_out"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top mb16">
                                    <div class="oe_kanban_top_left mt4">
                                        <strong class="o_kanban_record_title"><span><field name="name"/></span></strong>
                                    </div>
                                </div>

                                <div class="oe_kanban_details">
                                    <div class="row">
                                        <div class="col-8">
                                            <strong>Petty Cash Float :</strong> <field name="petty_cash_float" widget="monetary"/><br/>
                                            <t t-if="record.state.value != 'completed'">

                                                <strong>Cash Balance : </strong><field name="cash_balance" widget="monetary"/><br/>
                                            </t>
                                            <t t-else="">
                                                &#160;
                                            </t>
                                        </div>
                                        <div class="col-4 float-right">
                                            <h3><field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'in_progress': 'success','complete': 'info'}}"/>
                                            </h3>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <strong>Responsible User:</strong>  <field name="user_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>


        <!--   action petty cash     -->
        <record id="action_petty_cash" model="ir.actions.act_window">
            <field name="name">Petty Cash</field>
            <field name="res_model">petty.cash</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_petty_cash_filter"/>
            <field name="help" type="html">
             <p class="o_view_nocontent_smiling_face">
               Add a Petty cash Record
             </p>
            </field>
        </record>


    </data>
</odoo>
