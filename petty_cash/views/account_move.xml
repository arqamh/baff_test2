<odoo>
    <record id="view_account_move_filter_inherit" model="ir.ui.view">
        <field name="name">account.move.select.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='reversed']" position="after">
                    <filter string="Active Move(s)" name="reversed_move" domain="[('reversed_entry_id', '=', False)]"/>
                </xpath>
            </field>
    </record>
</odoo>