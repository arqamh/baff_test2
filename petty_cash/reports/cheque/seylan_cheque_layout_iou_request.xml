<?xml version="1.0" encoding="UTF-8"?>
<!--Custom report.-->
<!--check_with_account_payee_and_with_20-->
<odoo>
    <template id="cheque_seylan_iou_request">
        <t t-call="web.basic_layout">
            <div class="page" style="font-size:14px;">
                <t t-foreach="docs" t-as="o">
                    <table width="100%">
<!--                        <t t-set="name" t-value="str(o.partner_id.name).split()"/>-->
<!--                        <t t-set="length" t-value="len(name)"/>-->
                        <tr height="25px">
                            <td width="18%">&#160;</td>
                            <td width="9%">&#160;</td>
                            <td>&#160;</td>
<!--                            <td class="text-left"><span t-field="o.date"/></td>-->
                            <td width="25%" class="text-right">
                                <t t-if="o.is_cheque_ac_payee">
                                    <span style="border-top: 1px solid black; border-bottom: 1px solid black;">A/c Payee</span>
                                </t>
                                <t else="">
                                    &#160;
                                </t>
                            </td>
                            <td width="8%">&#160;</td>
                            <td width="22%" class="text-left" style="padding-top: 5px;">
                                <table width="100%" style="padding-top: 5px;">
                                    <tr>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[8:9]"/></td>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[9:10]"/></td>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[5:6]"/></td>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[6:7]"/></td>
                                        <td width="10%">&#160;</td>
                                        <td width="10%">&#160;</td>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[2:3]"/></td>
                                        <td width="10%"><span t-esc="str(o.cheque_date)[3:4]"/></td>
                                        <td width="20%">&#160;</td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr height="28px">
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
<!--                            <td class="text-left"><span t-esc="name[0]"/>&#160;<t t-if="length &gt;= 2"><span t-esc="name[1]"/></t></td>-->
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
                        </tr>
                        <tr height="47px">
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
<!--                            <td class="text-left">PV0019-16666</td>-->
                            <td><div style="margin-top: 3px;"><span t-field="o.employee_id"/></div></td>
                            <td>&#160;</td>
                            <td>&#160;</td>
                        </tr>
                        <tr height="34px">
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td rowspan="2" style="line-height: 2.2;"><span t-esc="o.currency_id.amount_to_text(o.released_amount)"/>&#160;Only</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
                        </tr>
                        <tr height="30px">
                            <td>&#160;</td>
                            <td>&#160;</td>
                            <td>&#160;</td>
<!--                            <td class="text-left"><div style="margin-top: 5px;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;<span t-esc="'{0:,.2f}'.format(float(o.amount)).replace(',', ',')"/></div></td>-->
                            <td>&#160;</td>
                            <td>&#160;&#160;<span t-esc="'{0:,.2f}'.format(float(o.released_amount)).replace(',', ',')"/></td>
                        </tr>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <record id="action_cheque_seylan_iou_request" model="ir.actions.report">
        <field name="name">Seylan Cheque</field>
        <field name="model">petty.cash.release</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">petty_cash.cheque_seylan_iou_request</field>
        <field name="report_file">petty_cash.cheque_seylan_iou_request</field>
        <field name="binding_model_id" ref="petty_cash.model_petty_cash_release"/>
        <field name="paperformat_id" ref="petty_cash_paperformat_seylan"/>
        <field name="binding_type">report</field>
    </record>
</odoo>