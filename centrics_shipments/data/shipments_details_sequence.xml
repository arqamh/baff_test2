<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences for shipments details records -->
        <record id="seq_shipment_details" model="ir.sequence">
            <field name="name">shipment details</field>
            <field name="code">shipments.details.sequence</field>
            <field name="prefix">SR</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>