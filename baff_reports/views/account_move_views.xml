<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.baff_reports</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
             <xpath expr="//page[@id='aml_tab']" position="after">
                 <page id="report_details" string="Report Details">
                    <group>
                        <field name="bank_1_details"/>
                        <field name="bank_2_details"/>
                        <field name="terms_conditions"/>
                    </group>
                     <group>
                        <field name="shipment_by"/>
                        <field name="net_weight"/>
                        <field name="gross_weight"/>
                        <field name="total_cmb"/>
                        <field name="no_of_packages"/>
                        <field name="tracking_no"/>
                        <field name="footer_note"/>
                    </group>
                 </page>
             </xpath>
             <xpath expr="//field[@name='invoice_line_ids']//field[@name='account_id']" position="after">
                  <field name="hs_code"/>
             </xpath>

        </field>
    </record>
</odoo>