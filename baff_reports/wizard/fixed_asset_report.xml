<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- Fixed Asset Wizard form-->
    <record id="view_fixed_asset_report_form" model="ir.ui.view">
        <field name="name">fixed.asset.report.form</field>
        <field name="model">fixed.asset.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                <group>
                    <field name="date_from"/>
                </group>
                <group>
                    <field name="date_to"/>
                </group>
                </group>
                <footer>
                    <button name='action_print_report' string='Print' type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Fixed Asset Action-->
    <record id="fixed_asset_report_wizard" model="ir.actions.act_window">
        <field name="name">Fixed Asset Register</field>
        <field name="res_model">fixed.asset.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fixed_asset_report_form"/>
        <field name="target">new</field>
    </record>

</odoo>