<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_pv" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.account.pv</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="40"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@data-key='account']" position="inside">
                    <h2>Payment Approval</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" title="Enables approval feature in vendor payment."
                             groups="account.group_account_manager">
                            <div class="o_setting_left_pane">
                                <field name="account_payment_approval"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="account_payment_approval"/>
                                <div class="text-muted">
                                    Enable to bring the approval in the payment .
                                </div>
                                <div class="content-group" attrs="{'invisible': [('account_payment_approval', '=', False)]}">
									<div class="row">
										<label string="Amount" for="payment_approval_amount"
											   class="col-lg-3 o_light_label"/>
										<field name="payment_approval_amount"
											   attrs="{'required': [('account_payment_approval', '=', True)]}"/>
									</div>
								</div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
