<odoo>
    <record id="view_move_form_inherit_internal" model="ir.ui.view">
        <field name="name">account.move.form.inherit.internal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_available_payments" invisible="1"/>
               <button name="action_view_payments_with_waiting_approval" type="object" class="oe_stat_button" icon="fa-bars"
                       attrs="{'invisible': [('is_available_payments', '=', False)]}"
                        string="Pending Payments"/>
            </xpath>
        </field>
    </record>
</odoo>