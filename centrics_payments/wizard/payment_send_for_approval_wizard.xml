<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Payment  User wizard and action-->
    <record id="account_payment_request_approver_wizard_form" model="ir.ui.view">
        <field name="name">payment.sendfor.approval.wizard.form</field>
        <field name="model">payment.sendfor.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Approval">
                <sheet>
                    <h2>Send for Approval</h2>
                    <group>
                        <group>
                            <field name="user_id" widget='selection'/>
                            <field name="payment_id" invisible="1"/>
                            <field name="model_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string='Submit' name="approval_submission" type="object" class="btn-primary"/>
                    <button string="Abort" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_payment_approver_wizard_action" model="ir.actions.act_window">
        <field name="name">Send for Approval</field>
        <field name="res_model">payment.sendfor.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_payment_request_approver_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>