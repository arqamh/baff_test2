<odoo>
    <data>

    <!--  ###########################  vendor payments -->
        <!--    Email templates for Payment Pending Approval-->
        <record id="mail_template_for_account_payment_approval" model="mail.template">
            <field name="name">Email for account payment Approval</field>
            <field name="email_from">{{user.email}}</field>
            <field name="subject">Approval of Payment {{ object.partner_id.name if object.partner_id else '' }} - {{ object.amount }}</field>
            <field name="email_to">{{ object.requested_approver_id.email }}</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html">
                <![CDATA[
                    </head>
                    <body style="margin: 0; padding: 0;">
                    <table border="0" width="100%" cellpadding="0" bgcolor="#ededed" style="padding: 20px; background-color: #ededed; border-collapse:separate;" summary="o_mail_notification">
                        <tbody>

                          <!-- HEADER -->
                          <tr>
                            <td align="center" style="min-width: 590px;">
                              <table width="590" border="0" cellpadding="0" bgcolor="#875A7B" style="min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;">
                                <tr>
                                  <td valign="middle">
                                      <span style="font-size:20px; color:white; font-weight: bold;">

                                      </span>
                                  </td>
                                  <td valign="middle" align="right">
                                      <img  t-attf-src="/logo.png?company={{object.create_uid.company_id.id}}" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="<t t-out="object.create_uid.company_id.name}}">
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>

                          <!-- CONTENT -->
                          <tr>
                            <td align="center" style="min-width: 590px;">
                              <table width="590" border="0" cellpadding="0" bgcolor="#ffffff" style="min-width: 590px; background-color: rgb(255, 255, 255); padding: 20px; border-collapse:separate;">
                                <tbody>
                                     <td valign="top" style="font-family:Arial,Helvetica,sans-serif; color: #555; font-size: 14px;">
                                    <p>Hi <t t-out="object.requested_approver_id.display_name"/>,</p><br/>

                                        There is a payment for your approval. Please do the needful.</p><br/>
                                         <p>Please <a t-attf-href="{{object.custom_url }}" target="_blank"><b>Click Here</b></a>  to visit.</p>

                                    <p>Thank you</p>
                                </tbody>
                              </table>
                            </td>
                          </tr>

                          <!-- FOOTER -->
                          <tr>
                            <td align="center" style="min-width: 590px;">
                              <table width="590" border="0" cellpadding="0" bgcolor="#875A7B" style="min-width: 590px; background-color: rgb(135,90,123); padding: 20px; border-collapse:separate;">
                                <tr>
                                  <td valign="middle" align="left" style="color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;">
                                    <t t-out="object.create_uid.company_id.name"/><br/>
                                    <t t-out="object.create_uid.company_id.phone"/>

                                  </td>
                                  <td valign="middle" align="right" style="color: #fff; padding-top: 10px; padding-bottom: 10px; font-size: 12px;">
                                    <a href="mailto:{{ object.create_uid.company_id.email }}" style="text-decoration:none; color: white;" t-out="object.create_uid.company_id.email"/><br/>
                                        <a t-attf-href="{{ object.create_uid.company_id.website}}" style="text-decoration:none; color: white;" t-out="object.create_uid.company_id.website"/>
                                  </td>
                                </tr>
                              </table>
                            </td>
                          </tr>
                        </tbody>
                    </table>
                    </body>
                    </html>
                    ]]>
            </field>
        </record>

