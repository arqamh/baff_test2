<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--inherit manufacturing orders-->
        <record id="fine_finish_erp_mrp_operations_view" model="ir.ui.view">
            <field name="name">fine.finish.erp.mrp.operations.view</field>
            <field name="model">mrp.routing.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='note']" position="after">
                    <field name="image" attrs="{'invisible':  [('worksheet_type', '!=', 'image')]}"/>
                </xpath>
                <xpath expr="//group[@name='workorder']//div[2]" position="after">
                    <field name="operation_duration_hrs" widget="float_time"/>
                </xpath>
                <xpath expr="//label[@for='time_cycle_manual']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='workorder']//div[2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>