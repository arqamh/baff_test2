<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="manufacturing_modifications_mrp_production_workorder_tree_editable_view" model="ir.ui.view">
        <field name="name">inherit.mrp.production.workorder.tree.editable.view</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='duration']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//tree//field[@name='duration_expected']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//tree//field[@name='duration']" position="after">
                <field name="real_duration_hrs" readonly="1" widget="float_time" sum="total"/>
                <field name="expected_duration_hrs" widget="float_time" sum="total"/>
            </xpath>
        </field>
    </record>
</odoo>