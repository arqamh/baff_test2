<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <!--inherit manufacturing orders form view-->
        <record id="fine_finish_erp_mrp_production_form" model="ir.ui.view">
            <field name="name">fine.finish.erp.mrp.production.form</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <!-- Add smart button for material requisitions -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_material_requisitions" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                        <field name="material_requisition_count" widget="statinfo" string="Material Requisitions"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="after">
                    <label for="progress" string="Progress"/>
                    <div class="o_row">
                        <field name="progress" force_save="1" nolabel="1"/>
                        <label for="progress" string="%" colspan="6"/>
                    </div>
                    <field name="is_cnc_complete"/>
                    <field name="current_state" invisible="1"/>
                    <field name="planned_start_date" invisible="1"/>
                    <field name="approval_required" invisible="1"/>
                    <field name="has_new_components_without_requisition" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="replace">
                </xpath>
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="analytic_account_id"/>
                    <field name="project_id"/>
                    <field name="job_costing_number"/>
                </xpath>
                <xpath expr="//field[@name='current_state']" position="after">
                    <field name="is_qc_by_supervisor" attrs="{'readonly': [('state', '=', 'done')]}"/>
                    <field name="quantity_check" attrs="{'readonly': [('state', '=', 'done')]}"/>
                </xpath>
                <xpath expr="//field[@name='date_planned_start']" position="attributes">
                    <attribute name="attrs">{'readonly': [('state', 'in', ['close', 'cancel', 'done'])]}</attribute>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="after">
                    <field name="quantity_check" invisible="1"/>
                    <field name="mo_completion" invisible="1"/>
                    <widget name="web_ribbon" title="Fail" bg_color="bg-danger"
                            attrs="{'invisible': [('mo_completion', '!=', 'fail')]}"/>
                    <widget name="web_ribbon" title="Fully Completed" bg_color="bg-success"
                            attrs="{'invisible': [('mo_completion', '!=', 'complete')]}"/>
                    <widget name="web_ribbon" title="Partially Completed" bg_color="bg-warning"
                            attrs="{'invisible': [('mo_completion', '!=', 'partial')]}"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="approval_state" widget="statusbar" attrs="{'invisible': [('approval_required', '=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='move_raw_ids']//tree" position="attributes">
                    <attribute name="decoration-warning">state == 'cancel'</attribute>
                </xpath>
                <!-- Make "To Consume" column readonly when MO is not in Draft state -->
                <xpath expr="//field[@name='move_raw_ids']//tree//field[@name='product_uom_qty']" position="attributes">
                    <attribute name="attrs">{'readonly': [('parent.state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="attrs">{'invisible': [('approval_required', '!=', False)]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_mark_done']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', '|', ('approval_required', '!=', False), ('state', 'in', ('draft', 'cancel', 'done', 'to_close')), ('qty_producing', '=', 0), ('move_raw_ids', '!=', [])]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_mark_done'][1]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', '|', ('approval_required', '!=', False), ('state', 'in', ('draft', 'cancel', 'done', 'to_close')), ('qty_producing', '=', 0), ('move_raw_ids', '=', [])]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_mark_done'][2]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('approval_required', '!=', False), ('move_raw_ids', '=', []),
                        '&amp;',
                        '|',
                        ('state', 'not in', ('confirmed', 'progress')),
                        ('qty_producing', '!=', 0),
                        ('state', '!=', 'to_close')]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_mark_done'][3]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('approval_required', '!=', False), ('move_raw_ids', '!=', []),
                        '&amp;',
                        '|',
                        ('state', 'not in', ('confirmed', 'progress')),
                        ('qty_producing', '!=', 0),
                        ('state', '!=', 'to_close')]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_unplan']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('approval_required', '!=', False), ('is_planned', '=', False), ('state', '=', 'cancel')]}</attribute>
                </xpath>

                <xpath expr="//button[@name='button_scrap']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('approval_required', '!=', False), ('state', 'in', ('cancel', 'draft'))]}</attribute>
                </xpath>

                <xpath expr="//button[@name='action_toggle_is_locked']" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', ('approval_required', '!=', False), ('show_lock', '=', False), ('is_locked', '=', False)]}</attribute>
                </xpath>

<!--                <xpath expr="//button[@name='action_cancel']" position="attributes">-->
<!--                    <attribute name="attrs">{'invisible': ['|', '|', '|', ('approval_required', '!=', False), ('id', '=', False), ('state', 'in', ('done', 'cancel')), ('confirm_cancel', '=', True)]}</attribute>-->
<!--                </xpath>-->

                <xpath expr="//button[@name='action_cancel'][1]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', '|', '|', ('approval_required', '!=', False), ('id', '=', False), ('state', 'in', ('done', 'cancel')), ('confirm_cancel', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel'][1]" position="after">
                    <button name="action_sent_for_approval" type="object" string="Send For Approval" class="btn btn-primary" attrs="{'invisible':['|', ('approval_state','!=','required_approval'), ('approval_required','=', False)]}"/>
                    <button name="action_user_approve" type="object" string="Approve" class="btn btn-primary" attrs="{'invisible':['|',('approval_state','!=',('waiting_approve')), ('approval_required', '=', False)]}"/>
                    <button name="action_user_reject" type="object" string="Reject" class="btn btn-danger" attrs="{'invisible':['|',('approval_state','!=',('waiting_approve')), ('approval_required', '=', False)]}"/>
                    <button name="add_new_component_operation" type="object" string="Process New Components" class="btn btn-info" attrs="{'invisible': [('has_new_components_without_requisition', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <!--inherit manufacturing orders list view -->
        <record id="fine_finish_erp_mrp_production_list" model="ir.ui.view">
            <field name="name">fine.finish.erp.mrp.production.list</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
                <!-- Add Project and Job Costing Sheet Number to tree view -->
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="project_id" optional="show"/>
                    <field name="job_costing_number" optional="show"/>
                </xpath>
            </field>
        </record>

        <!--inherit manufacturing orders kanban view -->
        <record id="fine_finish_erp_mrp_production_kanban" model="ir.ui.view">
            <field name="name">fine.finish.erp.mrp.production.kanban</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
                <xpath expr="//field[@name='date_planned_start']" position="attributes">
                    <attribute name="readonly">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>

            </field>
        </record>

        <!--rename analytic account name to project name-->
        <record id="fine_finish_erp_mrp_production_form_analytic_id" model="ir.ui.view">
            <field name="name">fine.finish.erp.mrp.production.form.analytic.id</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp_account.mrp_production_form_view_inherited"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='miscellaneous']//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="string">Project Number</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>