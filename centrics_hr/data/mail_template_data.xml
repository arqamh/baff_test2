<?xml version="1.0" encoding="UTF-8"?>
<odoo>
   <data>      <!-- Template for Approved Employee Email -->
      <record id="new_approved_mail_template" model="mail.template">
         <field name="name">EMPLOYEE CREATION APPROVED EMAIL</field>
         <field name="model_id" ref="model_hr_employee"/>
         <field name="email_from"/>
         <field name="email_to">{{ object.requested_by.login }}</field>
         <field name="subject">Approval Granted!</field>
         <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
               <div style="margin: 0px; padding: 0px;">
                  <p style="margin: 0px; padding: 0px; font-size: 15px;color:black;">
                     <b>Dear
                        <t t-out="object.requested_by.partner_id.name"/>,
                     </b>
                     <br/>
                     The request for the creation of a Employee has been approved!
                     <br/>
                     <br/>
                     <b>Employee Details</b>
                     <br/>
                     <b>Employee Name :</b>
                     <t t-out="object.name"/>,
                     <br/>
                     <b>Job Position :</b>
                     <t t-out="object.job_id.name"/>,
                     <br/>
                     <b>Department :</b>
                     <t t-out="object.department_id.name"/>.
                     <br/>
                     Please feel free to reach out if you need any support or further assistance.
                     <br/>
                     <br/>
                     Click Below Button to view the Employee
                     <p style="margin: 16px 0px 16px 0px; text-align: left;">
                        <a t-att-href="'/web#id=%s&amp;cids=%s&amp;model=hr.employee&amp;view_type=form' % (object.id,object.company_id.id)"
                           style="background-color: #9E588B; margin-top: 10px; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                           VIEW EMPLOYEE
                        </a>
                     </p>
                     <br/>
                     <br/>
                     Best Regards,
                     <br/>
                     <t t-out="object.env.user.name"/>
                     <br/>
                     <t t-out="object.company_id.name"/>
                  </p>
               </div>
            </div>
         </field>
      </record>

      <!-- Template for Approval Request Email -->
      <record id="to_approve_mail_template" model="mail.template">
         <field name="name">EMPLOYEE CREATION APPROVAL EMAIL</field>
         <field name="model_id" ref="model_hr_employee"/>
         <field name="email_from"/>
         <field name="email_to">{{ object.approver_id.login }}</field>
         <field name="subject">Request for Approval!</field>
         <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
               <div style="margin: 0px; padding: 0px;">
                  <p style="margin: 0px; padding: 0px; font-size: 15px;color:black;">
                     <b>Dear
                        <t t-out="object.approver_id.partner_id.name"/>
                        ,
                     </b>
                     <br/>
                     <br/>
                     Approval is requested for the creation of a new employee record in the system.
                     <br/>
                     <br/>
                     <b>Employee Details</b>
                     <br/>
                     <b>Employee Name :</b>
                     <t t-out="object.name"/>,
                     <br/>
                     <b>Job Position :</b>
                     <t t-out="object.job_id.name"/>,
                     <br/>
                     <b>Department :</b>
                     <t t-out="object.department_id.name"/>.
                     <br/>
                     <br/>
                     Thank you for your time and consideration.If you have any questions or require further information,
                     please feel free to reach out.
                     <br/>
                     <br/>
                     <br/>
                     Click Below Button to view the Employee
                     <p style="margin: 16px 0px 16px 0px; text-align: left;">
                        <a t-att-href="'/web#id=%s&amp;cids=%s&amp;model=hr.employee&amp;view_type=form' % (object.id,object.company_id.id)"
                           style="background-color: #9E588B; margin-top: 10px; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                           VIEW EMPLOYEE
                        </a>
                     </p>
                     <br/>
                     <br/>
                     Best Regards,
                     <br/>
                     <t t-out="object.env.user.name"/>
                     <br/>
                     <t t-out="object.env.user.phone"/>
                     <br/>
                     <t t-out="object.company_id.name"/>
                  </p>
               </div>
            </div>
         </field>
      </record>

      <!-- Template for Rejection Email -->
      <record id="reject_mail_template" model="mail.template">
         <field name="name">EMPLOYEE CREATION REJECTED EMAIL</field>
         <field name="model_id" ref="model_hr_employee"/>
         <field name="email_from"/>
         <field name="email_to">{{ object.requested_by.login }}</field>
         <field name="subject">Approval Rejected!</field>
         <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
               <div style="margin: 0px; padding: 0px;">
                  <p style="margin: 0px; padding: 0px; font-size: 13px;color:black;">
                     <b>Dear
                        <t t-out="object.requested_by.partner_id.name"/>,
                     </b>
                     <br/>
                     Thank you for submitting the request for the creation of a employee.
                     <br/>
                     We regret to inform you that the request for Creation of Employee has not been approved for below
                     Reason.
                     <br/>
                     <br/>
                     <b>Employee Name :</b>
                     <t t-out="object.name"/>,
                     <br/>
                     <b>
                        <i>Reason :<t t-out="ctx['order']['reason']"/>.
                        </i>
                     </b>
                     <br/>
                     <br/>
                     Please feel free to reach me for further insights or guidance for future requests.
                     <br/>
                     Click Below Button to view the Employee
                     <p style="margin: 16px 0px 16px 0px; text-align: left;">
                        <a t-att-href="'/web#id=%s&amp;cids=%s&amp;model=hr.employee&amp;view_type=form' % (object.id,object.company_id.id)"
                           style="background-color: #9E588B; margin-top: 10px; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 16px;">
                           VIEW EMPLOYEE
                        </a>
                     </p>
                     <br/>
                     <br/>
                     Best Regards,
                     <br/>
                     <t t-out="object.env.user.name"/>
                     <br/>
                     <t t-out="object.company_id.name"/>
                  </p>
               </div>
            </div>
         </field>
      </record>
   </data>
</odoo>
