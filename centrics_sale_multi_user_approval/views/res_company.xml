<odoo>
    <record id="centrics_sale_multi_user_approval_view_company_form" model="ir.ui.view">
        <field name="name">centrics.sale.multi.user.approval.view.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_info']" position="after">
                <page string="Sale Order Approvals">
                    <field name="sale_order_config_approval_line_ids">
                        <tree editable="top">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_from" required="1"/>
                            <field name="amount_to" required="1"/>
                            <field name="user_ids" widget="many2many_tags" required="1"/>
                        </tree>
                    </field>
                </page>
                <page string="Sales Validation Config" name="sales_validate_config">
                    <group>
                        <group>
                            <field name="gp_margin_validation" groups="centrics_sale_multi_user_approval.group_show_margin_sale_multi_user"/>
                            <field name="credit_limit_validation"
                                   groups="centrics_sale_multi_user_approval.group_show_credit_limit_and_payment_terms_sale_multi_user"/>
                            <field name="payment_terms_validation"
                                   groups="centrics_sale_multi_user_approval.group_show_credit_limit_and_payment_terms_sale_multi_user"/>
                        </group>
                        <group>
                            <field name="gp_margin_company" groups="centrics_sale_multi_user_approval.group_show_margin_sale_multi_user"
                                   attrs="{'invisible': [('gp_margin_validation', '=', False)]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>