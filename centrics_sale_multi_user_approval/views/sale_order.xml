<odoo>
    <record id="centrics_sale_multi_user_approval_view_order_form" model="ir.ui.view">
        <field name="name">centrics.sale.multi.user.approval.view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="before">
                <button name="send_for_approval" type="object" string="Send for Approval" states="draft,sent"/>
                <button name="update_approvers" type="object" string="Update Approvers" states="to approve"
                        groups="centrics_sale_multi_user_approval.group_sale_approve_manager"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <field name="hide_approve_reject_button" invisible="1"/>
                <button name="button_approve" type="object" string="Approve Order" class="oe_highlight"
                        attrs="{'invisible': ['|', ('hide_approve_reject_button', '=', True), ('state', '!=', 'to approve')]}"/>
                <button name="button_reject" type="object" string="Reject"
                        attrs="{'invisible': ['|', ('hide_approve_reject_button', '=', True), ('state', '!=', 'to approve')]}"/>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Approval Status">
                    <field name="sale_order_approval_line_ids">
                        <tree create="0" delete="0" editable="top">
                            <field name="sequence" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="approval_request_datetime" readonly="1"/>
                            <field name="status_updated_datetime" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>