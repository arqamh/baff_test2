<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_salary_rule_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.inherit.centrics.hr.payroll</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <field name="condition_select" position="after">
                <field name="fixed_allowance_deduction_id"/>
            </field>
            <xpath expr="//field[@name='appears_on_payslip']" position="after">
                <field name="appear_as_subtotal_in_payslip"/>
            </xpath>

            <!-- Add Custom Settings page after Accounting tab -->
            <xpath expr="//page[@name='accounting']" position="after">
                <page name="custom_settings" string="Custom Settings">
                    <group string="Basic Settings">
                        <field name="add_to_calc_epf_etf"/>
                    </group>
                    <group string="Detail Payroll Report">
                        <field name="appear_on_detail_payroll_report"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>