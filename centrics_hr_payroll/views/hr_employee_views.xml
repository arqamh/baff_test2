<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="payroll_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.centrics.hr.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='registration_number']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>