<odoo>

    <record id="request_purchase_requisitions_search_view" model="ir.ui.view">
        <field name="name">job.cost.line.search</field>
        <field name="model">job.cost.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" string="Job Costing"
                    filter_domain="['|', ('employee_id', 'ilike', self), ('job_costing_id', 'ilike', self)]"/>
                <field name="product_id"/>
                <field name="prepared_by"/>
                <filter string="To Order Qty" name="to_order_quantity" domain="[('to_order_quantity','>', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Job Costing Sheet" name="job_costing_id" context="{'group_by':'job_costing_id'}"/>
                    <filter string="Product" name="product_id" context="{'group_by':'product_id'}"/>
                    <filter string="Prepared" name="prepared_by" context="{'group_by':'prepared_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="request_purchase_requisitions_tree_view" model="ir.ui.view">
        <field name="name">Job.Cost.line.tree</field>
        <field name="model">job.cost.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="0" delete="0">
                <field name="product_id" string="Material"/>
                <field name="job_type" optional="hide"/>
                <field name="job_costing_id" optional="show" string="Source Document"/>
                <field name="scheduled_date" optional="show" string="Scheduled Date" widget="date"/>
                <field name="partner_id" optional="show" />
                <field name="component" optional="show" />
                <field name="parent_bom_id" optional="hide" />
                <field name="product_qty" attrs="{'invisible':[('job_type','=','labour')]}" string="Quantity Required"/>
                <field name="to_order_quantity" string="To Order"/>
                <field name="extra_qty"/>
                <field name="pr_created_qty" string="Requested Quantity" optional="show"/>
                <field name="actual_quantity" string="Received Quantity" optional="show"/>
                <field name="actual_remaining_qty" string="Remaining Quantity" optional="show"/>
                <field name="status" string="Status" widget="badge" decoration-success="status == 'completed'"
                           decoration-warning="status == 'pending'"
                           decoration-info="status == 'partial'"/>
                <field name="priority" widget="priority" optional="show" invisible="1"/>
                <field name="basis" attrs="{'invisible':[('job_type','!=','overhead')]}" optional="hide" invisible="1"/>
                <field name="uom_id" attrs="{'invisible':[('job_type','=','labour')]}" optional="hide"/>
                <field name="actual_invoice_quantity" invisible="1"/>
                <field name="hours" attrs="{'invisible':[('job_type','!=','labour')]}" invisible="1"/>
                <field name="actual_hour" invisible="1"/>
                <field name="cost_price" invisible="1"/>
                <field name="reference" optional="hide" invisible="1"/>
                <field name="prepared_by" optional="hide" invisible="1"/>
                <field name="description" optional="hide" invisible="1"/>
                <field name="currency_id" invisible="1" optional="show"/>
                <field name="total_cost" widget="monetary" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="model_request_purchase_requisitions_create_req" model="ir.actions.server">
        <field name="name">Create Material Requisitions</field>
        <field name="model_id" ref="odoo_job_costing_management.model_job_cost_line"/>
        <field name="binding_model_id" ref="odoo_job_costing_management.model_job_cost_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.create_purchase_requisitions_wizard()</field>
    </record>

    <record id="request_purchase_requisitions_action" model="ir.actions.act_window">
        <field name="name">Material Requisitions Plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">job.cost.line</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('job_type','=', 'material'), ('material_type','=', 'component'), ('job_costing_id.state','=', 'done')]</field>
        <field name="context">
            {'default_job_type':'material',
            'search_default_job_costing_id':True,
            'search_default_to_order_quantity':1}
        </field>
        <field name="view_id" ref="request_purchase_requisitions_tree_view"/>
        <field name="search_view_id" ref="request_purchase_requisitions_search_view"/>
    </record>

    <menuitem id="menu_request_purchase_requisitions"
              name="Material Requisition Plan"
              parent="material_purchase_requisitions.menu_item_purchase_requisition"
              sequence="0"
              action="request_purchase_requisitions_action"/>
</odoo>