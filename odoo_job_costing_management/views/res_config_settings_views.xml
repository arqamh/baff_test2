<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--settings for job costing management-->
        <record id="job_costing_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">job.costing.res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="Job Costing" id="job_costing" string="Job Costing"
                         data-key="odoo_job_costing_management">
                        <h2>Job Costing</h2>
                        <div class="row mt16 o_settings_container" id="job_costing_setting">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="Profit Margin" for="profit_margin" class="col-lg-3 o_light_label"/>
                                            <field name="profit_margin" />%
                                            <div class="text-muted">
                                                Set a profit margin for the job costing sheet
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box"
                                 id="job-costing_sequence"
                                 title=".">
                                <div class="o_setting_left_pane">
                                </div>
                                <div class="o_setting_right_pane">
                                    <label string="Sequence Prefix" for="job_cost_prefix" class="col-lg-3 o_light_label"/>
                                    <field name="job_cost_prefix"/>
                                    <div class="text-muted">
                                        Set the prefix for the Job Costing Sheet Number. The sequence you configer gere will appear with the incremental number.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container" id="vendor_pricing_setting">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label string="Vendor Price Margin" for="vendor_price_margin" class="col-lg-3 o_light_label"/>
                                            <field name="vendor_price_margin" />%
                                            <div class="text-muted">
                                                Set a job costing price margin for vendors mapping in the product template.
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                             <div class="col-12 col-lg-6 o_setting_box" id="job-costing_sequence" title=".">
                                <div class="o_setting_left_pane"></div>
                                <!-- Set the suffix for revise job costing sheet -->
                                <div class="o_setting_right_pane">
                                    <label string="Revise Sequence Suffix" for="job_cost_revise_suffix" class="col-lg-3 o_light_label"/>
                                    <field name="job_cost_revise_suffix"/>
                                    <div class="text-muted">
                                        Set the Suffix for the Revise Job Costing Sheet Number. The sequence you configer will appear with the incremental number.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <!--menu for the settings under configurations-->
        <record id="job_costing_management_config_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'odoo_job_costing_management', 'bin_size': False}</field>
        </record>

        <menuitem id="menu_settings"
                  name="Settings"
                  parent="menu_job_cost_configuration"
                  sequence="0"
                  action="job_costing_management_config_settings_action"/>
    </data>
</odoo>
