<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="job_costing_form_view">
            <field name="name">Job.Costing.Form</field>
            <field name="model">job.costing</field>
            <field name="arch" type="xml">
                <form string='Job Costing form'>
                    <header>
<!--                        <button name="create_bom" type="object" string="Create BOM" class="oe_highlight" data-hotkey="a"  attrs="{'invisible': [('state', '!=', 'draft')]}"/>-->
                        <button name="action_add_standard_components" type="object" string="Add Standard Components" class="oe_highlight" data-hotkey="c"  attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_change_supplier" type="object" string="Change Supplier" class="oe_highlight" data-hotkey="s"  attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_sent_for_first_approval" type="object" string="Send For Review" class="oe_highlight" data-hotkey="v"  attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                        <button name="action_sent_for_second_approval" type="object" string="Send For Approval" states="confirm" class="btn-primary"/>
                        <button name="action_sent_for_production_approval" type="object" string="Send For Production Approval" states="ready_for_production" class="btn-primary"/>
                        <button name="action_first_approve" type="object" string="Reviewed" class="btn btn-primary" attrs="{'invisible':['|', ('hide_approve_reject_button', '=', True), ('state', '!=', 'waiting_first_approval')]}"/>
                        <field name="hide_approve_reject_button" invisible="1"/>
                        <button name="action_second_approve" type="object" string="Approve" class="btn btn-primary" attrs="{'invisible':['|', ('hide_approve_reject_button', '=', True), ('state', '!=', 'waiting_second_approval')]}"/>
                        <button name="action_production_approve" type="object" string="Approve" class="btn btn-primary" attrs="{'invisible':['|', ('hide_approve_reject_button', '=', True), ('state', '!=', 'waiting_production_approval')]}" groups="odoo_job_costing_management.group_job_costing_production"/>
                        <button name="update_approvers" type="object" string="Update Approvers" states="waiting_first_approval,waiting_second_approval,waiting_production_approval" groups="odoo_job_costing_management.group_jobcosting_approve_manager"/>
                        <button name='action_draft' type="object" string='Reset to Draft' states='cancel'/>
                        <button name='action_add_lines' type="object" string='Add Invoiceable Lines'/>
                        <button name='action_revise_job_costing' type="object" string='Revise Job Costing Sheet' attrs="{'invisible':[('state','!=','done')]}" groups="odoo_job_costing_management.group_revise_job_costing_manager"/>
                        <button name='action_update_prices' type="object" string='Update Prices' attrs="{'invisible':[('state', 'not in', ['ready_for_production', 'waiting_production_approval'])]}"/>
                        <button name='action_user_reject' type="object" string='Reject' attrs="{'invisible':['|', ('hide_approve_reject_button', '=', True), ('state', 'not in', ['waiting_first_approval', 'waiting_second_approval', 'waiting_production_approval'])]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_lead"
                                    string="Inquiry"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-star">
                            </button>
                            <button name="action_open_quotation" groups="odoo_job_costing_management.group_job_costing_all_costs"
                                    string="Quotation"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-usd">
                            </button>
                            <button name="action_view_purchase_requisitions"
                                    string="Requisitions"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-bars"
                                    attrs="{'invisible':[('purchase_requisition_ids', '=', [])]}"
                            >
                            </button>
                            <button name="action_view_purchase_order_line"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-pencil-square-o">
                                <field string="Purchase Order Lines" name="purchase_order_line_count" widget="statinfo"/>
                            </button>
                            <button name="action_view_invoices"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-file-text-o"
                                    attrs="{'invisible': [('invoice_count', '=', 0)]}">
                                <field string="Invoices" name="invoice_count" widget="statinfo"/>
                            </button>
<!--                            <button name="action_view_hr_timesheet_line"-->
<!--                                    type="object"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-book">-->
<!--                                <field string="HR Timesheet Lines" name="timesheet_line_count" widget="statinfo"/>-->
<!--                            </button>-->
<!--                            <button name="action_view_vendor_bill_line"-->
<!--                                    type="object"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-bars">-->
<!--                                <field string="Vendor Invoice Lines" name="account_invoice_line_count" widget="statinfo"/>-->
<!--                            </button>-->
<!--                            <button name="action_view_jobcost_sheet_lines"-->
<!--                                    type="object"-->
<!--                                    class="oe_stat_button"-->
<!--                                    icon="fa-pencil-square-o">-->
<!--                                <field string="Cost Lines" name="job_costsheet_line_count" widget="statinfo"/>-->
<!--                            </button>-->
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="number"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="quotation_id" readonly="1" groups="odoo_job_costing_management.group_job_costing_all_costs"/>
                                <field name="partner_id" readonly="1" force_save="1"/>
                                <field name="boat_type_id" readonly="1" force_save="1"/>
                                <field name="start_date" required="1"/>
                                <field name="project_name" required="1"/>
                                <field name="project_start_date" attrs="{'required' : [('state', '=', 'done')]}"/>
                                <field name="sale_id" readonly="1" attrs="{'invisible' : [('sale_id', '=', False)]}" groups="odoo_job_costing_management.group_job_costing_all_costs"/>
                                <field name="name" attrs="{'readonly' : [('state','in',('approve','done','cancel'))]}" invisible="1"/>
                                <field name="analytic_plan_id"/>
                                <field name="job_number" invisible="1"/>
                                <field name="po_number" invisible="1"/>
                                <field name="create_date"/>
                                <field name="project_id" attrs="{'readonly' : [('state','in',('approve','done','cancel'))]}" invisible="1"/>
                                <field name="task_id" attrs="{'readonly' : [('state','in',('approve','done','cancel'))]}" invisible="1"/>
                            </group>
                            <group>
                                <field name="lead_id" readonly="1"/>
                                <field name="project_id" readonly="1" attrs="{'invisible' : [('project_id', '=', False)]}"/>
                                <field name="complete_date"/>
                                <field name="sales_person_id"/>
                                <field name="user_id"/>
                                <field name="priority"/>
                                <field name="job_grade" invisible="1"/>
                                <field name="purchase_requisition_ids" widget="many2many_tags" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="so_number" attrs="{'readonly' : [('state','in',('approve','done','cancel'))]}" invisible="1"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                                <field name="customer_currency_id" groups="base.group_multi_currency" readonly="1"/>
                                <field name="currency_rate" groups="base.group_multi_currency" string="Exchange Rate" attrs="{'invisible' : [('customer_currency_id','=', False)]}"/>
                                <field name="analytic_id" attrs="{'invisible' : [('analytic_id','=', False)]}"/>
                                <field name="line_type" invisible="1"/>
                                <field name="labour_line_type" invisible="1"/>
                                <field name="bom_domain_ids" invisible="1"/>
                                <field name="parent_bom_domain_ids" invisible="1"/>
                                <field name="is_revised" readonly="1"/>
                            </group>
                        </group>
                        <field name="description" attrs="{'readonly' : [('state','in',('approve','done','cancel'))]}" placeholder="Description"/>
                        <notebook>
                            <page string="Finished Goods" name="job_cost_finished_goods_page">
                                <field name="finished_good_ids" readonly="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="product_id"/>
                                        <field name="product_qty"/>
                                        <field name="product_uom_id" optional="hide"/>
                                        <field name="unit_price" readonly="1"/>
                                        <field name="subtotal_cost" readonly="1"/>
                                        <field name="bom_id" readonly="1" optional="show"/>
                                        <field name="mrp_production_id" readonly="1" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Materials" name="job_cost_material_page">
                                <field name="job_cost_line_ids" nolabel="1" context="{'default_job_type':'material'}" attrs="{'readonly' : [('state', 'in', ['cancel', 'approved', 'ready_for_production', 'waiting_production_approval', 'done'])]}">
                                    <tree editable="bottom" decoration-success="is_new_item == True">
                                        <control>
                                            <create name="add_product_control" string="Add Components" context="{'default_line_type': 'component'}"/>
                                            <create name="add_section_control" string="Add Materials" context="{'default_line_type': 'material'}"/>
                                        </control>
                                        <field name="calculate_bom_total" invisible="1"/>
                                        <field name="job_type" invisible="1"/>
                                        <field name="mrp_qty" invisible="1"/>
                                        <field name="mrp_time" invisible="1"/>
                                        <field name="mrp_cost" invisible="1"/>
                                        <field name="budget_cost" invisible="1"/>
                                        <field name="actual_cost" invisible="1"/>
                                        <field name="is_new_item" invisible="1"/>
                                        <field name="related_vendor_ids" invisible="1"/>
                                        <field name="sequence" widget="handle"/>
                                        <field name="is_include_report" nolabel="1" readonly="0"/>
                                        <field name="selected" nolabel="1" attrs="{'invisible' : [('material_type','!=','component')]}"/>
                                        <field name="material_index" invisible="1"/>
                                        <field name="material_type" invisible="1"/>
                                        <field name="component" attrs="{'readonly': [('line_type', 'in', ['component', 'material'])]}"/>
                                        <field name="parent_bom_id" string="Parent Component" attrs="{'column_invisible': [('parent.line_type', 'not in', ['component', 'material'])], 'required': [('parent.line_type', 'in', ['component', 'material'])]}" domain="[('id', 'in', parent.parent_bom_domain_ids)]"/>
                                        <field name="bom_id" attrs="{'column_invisible': [('parent.line_type', '!=', 'component')]}" context="{'default_is_additional_component': True, 'job_line': bom_id, 'form_view_ref':'odoo_job_costing_management.job_mrp_bom_form_view'}" domain="[('id', 'in', parent.bom_domain_ids)]" options="{'no_open':True}"/>
                                        <field name="product_id" required="0" attrs="{'invisible': [('material_type', 'in', ['bom', 'parent'])], 'readonly': [('line_type', '=', 'component')]}" options="{'no_quick_create':True}"/>
                                        <field name="description" required="0" invisible="1"/>
                                        <field name="reference" invisible="1"/>
                                        <field name="cost_center_dependency" invisible="1"/>
                                        <field name="product_qty"/>
                                        <field name="uom_id"/>
                                        <field name="partner_id" domain="[('id', 'in', related_vendor_ids )]" attrs="{'invisible' : [('line_type','!=','material'), ('material_type','!=','component')]}"/>
                                        <field name="cost_price" attrs="{'invisible' : [('line_type','!=','material'), ('material_type','!=','component')]}"/>
                                        <field name="supplier_currency_id" force_save="1" readonly="1"/>
                                        <field name="supplier_currency_rate" force_save="1" attrs="{'readonly': [('is_same_currency_id', '=', True)]}"/>
                                        <field name="is_same_currency_id" invisible="1"/>
                                        <field name="actual_quantity" invisible="1"/>
                                        <field name="remaining_qty" invisible="1"/>
                                        <field name="actual_invoice_quantity" invisible="1"/>
                                        <field name="total_cost" invisible="1"/>
                                        <field name="rollup_cost" invisible="1"/>
                                        <field name="display_total_cost" string="Sub Total" widget="monetary"/>
                                        <field name="prepared_by" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="job_costing_id" invisible="1"/>
                                        <field name="line_type" invisible="1"/>
<!--                                        <button name="change_supplier" type="object" icon="fa-arrow-right" string="Change Supplier" attrs="{'invisible': [('partner_id', '=', False)]}"/>-->
                                    </tree>
                                </field>
<!--                                <button name="action_add_components" string="Add Components" type="object" icon="fa-plus-square"/>-->
<!--                                <button name="action_add_components" string="Add Materials" type="object" icon="fa-plus-circle"/>-->
                            </page>
                            <page string="Workcenters &amp; Labours" name="job_cost_labour_page">
                                <field name="job_labour_line_ids" nolabel="1" context="{'default_job_type':'labour'}" attrs="{'readonly' : [('state', 'in', ['cancel', 'approved', 'ready_for_production', 'done'])]}">
                                    <tree editable="bottom" decoration-success="is_new_item == True">
                                        <control>
                                            <create name="add_product_control" string="Add Operations" context="{'default_labour_line_type': True}"/>
                                        </control>
                                        <field name="job_type" invisible="1"/>
                                        <field name="labour_line_type" invisible="1"/>
                                        <field name="is_new_item" invisible="1"/>
                                        <field name="sequence" widget="handle"/>
                                        <field name="labour_index" invisible="1"/>
                                        <field name="component"/>
                                        <field name="parent_bom_id" invisible="1" string="Parent Component"/>
                                        <field name="bom_id" attrs="{'column_invisible': [('parent.labour_line_type', '=', False)]}"/>
                                        <field name="job_type_id" invisible="1"/>
                                        <field name="work_center_id" required="0"/>
                                        <field name="bom_operation_id" readonly="1" force_save="1"/>
                                        <field name="employee_id"/>
                                        <field name="description" invisible="1"/>
                                        <field name="reference" invisible="1"/>
                                        <field name="hour" widget="float_time"/>
                                        <field name="operation_start_date"/>
                                        <field name="operation_end_date"/>
                                        <field name="qty" invisible="1"/>
                                        <field name="hours" widget="float_time" invisible="1"/>
                                        <field name="workcenter_cost_price"/>
                                        <field name="employee_cost_price"/>
                                        <field name="cost_price_per_hour" string="Total Cost per Hour"/>
                                        <field name="actual_hour" widget="float_time" invisible="1"/>
                                        <field name="total_cost" widget="monetary" sum="Sub Total"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="job_costing_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Overhead" name="job_cost_overhead_page">
                                <field name="job_overhead_line_ids" nolabel="1" context="{'default_job_type':'overhead'}" attrs="{'readonly' : [('state', 'in', ['cancel', 'approved', 'ready_for_production', 'waiting_production_approval', 'done'])]}">
                                    <tree editable="bottom">
                                        <field name="job_type" invisible="1"/>
                                        <field name="job_type_id" domain="[('job_type','=',job_type)]" invisible="1"/>
                                        <field name="available_for_production_team" invisible="1"/>
                                        <field name="product_id" required="1" domain="[('detailed_type', '=', 'service')]" string="Description"/>
                                        <field name="description" invisible="1"/>
                                        <field name="product_qty"/>
                                        <field name="uom_id"/>
                                        <field name="cost_price"/>
                                        <field name="actual_quantity" invisible="1"/>
                                        <field name="actual_invoice_quantity" invisible="1"/>
                                        <field name="total_cost" widget="monetary" sum="Total"/>
                                        <field name="prepared_by"/>
                                        <field name="checked_by" invisible="1"/>
                                        <field name="approved_by" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="job_costing_id" invisible="1"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Variant Analysis" attrs="{'invisible' : [('state', '!=', 'done')]}">
                                <field name="cost_analysis_line">
                                    <tree decoration-danger="total_cost_variance &lt; 0">
                                        <field name="currency_id" invisible="1"/>
                                        <field name="job_costing_id" invisible="1"/>
                                        <field name="job_type" invisible="1"/>
                                        <field name="boat_type_id" optional="show"/>
                                        <field name="inventory_location_id" optional="show"/>
                                        <field name="product_category_id" optional="show"/>
                                        <field name="product_code" optional="show"/>
                                        <field name="product_id" required="1" string="Article Description" optional="show"/>
                                        <field name="description" required="1" optional="show"/>
                                        <field name="uom_id" string="Unit" optional="show"/>
                                        <field name="partner_id" string="Supplier" optional="show"/>
                                        <field name="vendor_reference" optional="show"/>
                                        <!-- Quantity: Planned | Actual | Difference -->
                                        <field name="product_qty" string="Planned Qty" optional="show"/>
                                        <field name="hour" widget="float_time" string="Planned Hrs" optional="show"/>
                                        <field name="mrp_qty" string="Actual Qty" optional="show"/>
                                        <field name="mrp_time" widget="float_time" string="Actual Hrs" optional="show"/>
                                        <field name="qty_variance" string="Qty Difference" optional="show"/>
                                        <!-- Unit Cost: Planned | Actual | Difference -->
                                        <field name="cost_price_company_currency" string="Planned Unit Cost" optional="show"/>
                                        <field name="mrp_cost" string="Actual Unit Cost" optional="show"/>
                                        <field name="unit_cost_variance" string="Unit Cost Difference" optional="show"/>
                                        <!-- Total Cost: Planned | Actual | Difference -->
                                        <field name="budget_cost" sum="Total" string="Planned Total Cost" optional="show"/>
                                        <field name="actual_cost" sum="Total" string="Actual Total Cost" optional="show"/>
                                        <field name="total_cost_variance" sum="Total" string="Total Cost Difference" optional="show"/>
                                    </tree>
                                </field>
                            </page>
<!--                            <page string="Additional Information" name="additional_information">-->
<!--                                <group>-->
<!--                                    <group string="First Approval Details">-->
<!--                                        <field name="first_approval_requested_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="first_approval_requested_by"  readonly="1" force_save="1"/>-->
<!--                                        <field name="first_approval_requested_users"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="first_approved_by"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="first_approved_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="first_approved_note"  readonly="1" force_save="1"/>-->
<!--                                        <field name="is_all_users_approve"  invisible="1"/>-->
<!--                                    </group>-->
<!--                                    <group string="Second Approval Details">-->
<!--                                        <field name="approval_requested_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="approval_requested_by"  readonly="1" force_save="1"/>-->
<!--                                        <field name="approval_requested_users"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="approved_by"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="approved_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="approved_note"  readonly="1" force_save="1"/>-->
<!--                                    </group>-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <group string="Production Approval Details">-->
<!--                                        <field name="production_approval_requested_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="production_approval_requested_by"  readonly="1" force_save="1"/>-->
<!--                                        <field name="production_approval_requested_users"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="production_approved_by"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="production_approved_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="production_approved_note"  readonly="1" force_save="1"/>-->
<!--                                    </group>-->
<!--                                    <group string="Reject Details">-->
<!--                                        <field name="rejected_by"  readonly="1" force_save="1" widget="many2many_tags"/>-->
<!--                                        <field name="rejected_date"  readonly="1" force_save="1"/>-->
<!--                                        <field name="rejected_note"  readonly="1" force_save="1"/>-->
<!--                                    </group>-->
<!--                                </group>-->
<!--                            </page>-->
                            <page string="Approval Status">
                                <field name="job_costing_approval_line_ids">
                                    <tree create="0" delete="0">
                                        <field name="sequence" invisible="1"/>
                                        <field name="user_id" readonly="1" force_save="1"/>
                                        <field name="approval_request_datetime" readonly="1" force_save="1"/>
                                        <field name="status_updated_datetime" readonly="1" force_save="1"/>
                                        <field name="state" readonly="1" force_save="1"/>
                                        <field name="comment" readonly="1" force_save="1"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="jobcost_total">
                                <field name="material_total" widget="monetary"/>
                                <field name="labor_total" widget="monetary"/>
                                <field name="overhead_total" widget="monetary"/>
                                <field name="gross_jobcost_total" widget="monetary"/>
                                <field name="factory_and_admin_overhead" widget="monetary" invisible="1"/>
                                <field name="gross_profit_markup"/>
                                <field name="profit_margin" widget="monetary"/>
                                <field name="sale_commission_price" widget="monetary"/>
                                <field name="profit_margin_percentage"/>
                                <field name="sale_commission_margin" widget="monetary"/>
                                <field name="jobcost_total" widget="monetary"/>
                                <field name="same_customer_company_currency" invisible="1"/>
                                <field name="total_price_customer_currency" widget="monetary" options="{'currency_field': 'customer_currency_id'}" attrs="{'invisible':[('same_customer_company_currency','!=', True)]}"/>
                            </group>
                            <label for="notes_job"/>
                            <field name="notes_job" class="oe_inline" nolabel="1" placeholder="Remarks / Final Price"/>
                            <div class="oe_clear"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="job_costing_tree_view" model="ir.ui.view">
            <field name="name">Job.Costing.List</field>
            <field name="model">job.costing</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="number"/>
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="start_date"/>
                    <field name="complete_date"/>
                    <field name="jobcost_total" widget="monetary"/>
                    <field name="company_id" invisible='1' groups="base.group_multi_company"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="job_costing_search" model="ir.ui.view">
            <field name="name">job_costing_search</field>
            <field name="model">job.costing</field>
            <field name="arch" type="xml">
                <search string="Search Job Coasting">
                    <field name="number"/>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="complete_date"/>
                    <field name="project_id"/>
                    <field name="partner_id"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <!-- <filter string="Confirm Job Costing" domain="[('state','=','confirm')]"/>
                     <filter string="Approved Job Costing" domain="[('state','=','approve')]"/>
                     <filter string="Done Job Costing" domain="[('state','=','done')]"/>
                     <filter string="Cancel Job Costing" domain="[('state','=','cancel')]"/>
                     <group expand="0" string="Group By">
                         <filter string="User" context="{'group_by':'user_id'}"/>
                         <filter string="Customer" context="{'group_by':'partner_id'}"/>
                         <filter string="Project" context="{'group_by':'project_id'}"/>
                         <filter string="Start Date" context="{'group_by':'start_date'}"/>
                         <filter string="Company" context="{'group_by':'company_id'}"/>
                     </group>-->
                    <filter string="Confirm Job Costing" name="confirm_state" domain="[('state','=','confirm')]"/>
                    <filter string="Approved Job Costing" name="approved_jobcosting" domain="[('state','=','approve')]"/>
                    <filter string="Done Job Costing" name="done_job_costing" domain="[('state','=','done')]"/>
                    <filter string="Cancel Job Costing" name="cancel_job_costing" domain="[('state','=','cancel')]"/>
                    <group expand="0" string="Group By">
                        <filter string="User" name="user_id" context="{'group_by':'user_id'}"/>
                        <filter string="Customer" name="customer" context="{'group_by':'partner_id'}"/>
                        <filter string="Project" name="project" context="{'group_by':'project_id'}"/>
                        <filter string="Start Date" name="start_date" context="{'group_by':'start_date'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="job_cost_line_tree_view" model="ir.ui.view">
            <field name="name">Job.Cost.line.tree</field>
            <field name="model">job.cost.line</field>
            <field name="arch" type="xml">
                <tree create="false" edit="0" delete="0">
                    <field name="job_type" optional="hide"/>
                    <field name="product_id"/>
                    <field name="description" optional="hide"/>
                    <field name="reference"/>
                    <field name="basis" attrs="{'invisible':[('job_type','!=','overhead')]}" optional="hide"/>
                    <field name="product_qty" attrs="{'invisible':[('job_type','=','labour')]}"/>
                    <field name="uom_id" attrs="{'invisible':[('job_type','=','labour')]}" optional="hide"/>
                    <field name="actual_quantity"/>
                    <field name="actual_invoice_quantity" />
                    <field name="hours" attrs="{'invisible':[('job_type','!=','labour')]}"/>
                    <field name="actual_hour"/>
                    <field name="cost_price"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_cost" widget="monetary"/>
                    <field name="job_costing_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_job_costing">
            <field name="name">Job Cost Sheets</field>
            <field name="res_model">job.costing</field>
            <!--        <field name="view_type">form</field>-->
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="action_job_cost_line_custom">
            <field name="name">Job Cost Sheet Lines</field>
            <field name="res_model">job.cost.line</field>
            <field name="context">{'group_by':'job_type'}</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!--production group access for the project start date field in sales module-->
        <record id="fine_finish_erp_job_costing_project_start_date" model="ir.ui.view">
            <field name="name">fine.finish.erp.job.costing.project.start.date</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_start_date']" position="attributes">
                    <attribute name="groups">odoo_job_costing_management.group_job_costing_production</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

