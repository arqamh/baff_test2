<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--inherit manufacturing orders-->
    <record id="job_cost_mrp_production_form" model="ir.ui.view">
        <field name="name">job.cost.mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_planned_start']" position="after">
                <field name="job_cost_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="total_budget_cost" invisible="1"/>
                <field name="total_actual_cost" invisible="1"/>
            </xpath>
<!--            <xpath expr="//div[@name='button_box']" position="after">-->
<!--                <widget name="web_ribbon" title="Budget Exceeded" bg_color="bg-danger"-->
<!--                            attrs="{'invisible': [('total_budget_cost', '>', 'total_actual_cost')]}"/>-->
<!--            </xpath>-->
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="Variant Analysis" attrs="{'invisible': [('mrp_production_source_count', '>=', 1)]}">
                    <field name="cost_analysis_line">
                        <tree decoration-danger="total_cost_variance &lt; 0">
                            <field name="currency_id" invisible="1"/>
                            <field name="job_costing_id" invisible="1"/>
                            <field name="job_type" invisible="1"/>
                            <field name="boat_type_id"/>
                            <field name="inventory_location_id"/>
                            <field name="product_category_id"/>
                            <field name="product_code"/>
                            <field name="product_id" required="1" string="Article Description"/>
                            <field name="description" required="1"/>
                            <field name="uom_id" string="Unit"/>
                            <field name="partner_id" string="Supplier"/>
                            <field name="vendor_reference"/>
                            <!-- Quantity: Planned | Actual | Difference -->
                            <field name="product_qty" string="Planned Qty"/>
                            <field name="hour" widget="float_time" string="Planned Hrs"/>
                            <field name="mrp_qty" string="Actual Qty"/>
                            <field name="mrp_time" widget="float_time" string="Actual Hrs"/>
                            <field name="qty_variance" string="Qty Difference"/>
                            <!-- Unit Cost: Planned | Actual | Difference -->
                            <field name="cost_price_company_currency" string="Planned Unit Cost"/>
                            <field name="mrp_cost" string="Actual Unit Cost"/>
                            <field name="unit_cost_variance" string="Unit Cost Difference"/>
                            <!-- Total Cost: Planned | Actual | Difference -->
                            <field name="budget_cost" sum="Total" string="Planned Total Cost"/>
                            <field name="actual_cost" sum="Total" string="Actual Total Cost"/>
                            <field name="total_cost_variance" sum="Total" string="Total Cost Difference"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="job_cost_mrp_production_tree" model="ir.ui.view">
        <field name="name">job.cost.mrp.production.tree</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="job_cost_id"/>
                <field name="sale_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>