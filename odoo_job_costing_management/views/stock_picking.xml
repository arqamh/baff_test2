<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="odoo_security_check_view_picking_form" model="ir.ui.view">
        <field name="name">odoo.security.check.view.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="security_check" invisible="1"/>
                <widget name="web_ribbon" title="Checked" bg_color="bg-success"
                        attrs="{'invisible': [('security_check', '=', False)]}"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_security_check" type="object" string="Security Check"
                        attrs="{'invisible': [('security_check', '!=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>