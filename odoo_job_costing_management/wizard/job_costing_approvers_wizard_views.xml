<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Approval User wizard and action-->
    <record id="job_costing_approvers_wizard" model="ir.ui.view">
        <field name="name">job.costing.approvers.wizard.form</field>
        <field name="model">job.costing.approvers.wizard</field>
        <field name="arch" type="xml">
            <form string="Approvers">
                <sheet>
                    <field name="name" readonly="1"/>
                    <field name="type" invisible="1"/>
                    <field name="approval_type" invisible="0"/>
                    <field name="job_costing_approver_line_ids">
                        <tree editable="bottom">
                            <field name="sequence" required="1" widget="handle"/>
                            <field name="user_id" required="1"/>
                            <field name="job_costing_line_id" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button string='Send for Review' name="send_for_approval" type="object" class="btn-primary" attrs="{'invisible': [('approval_type', '!=', 'review')]}"/>
                    <button string='Send for Approval' name="send_for_approval" type="object" class="btn-primary" attrs="{'invisible': [('approval_type', '!=', 'approve')]}"/>
                    <button string='Update' name="send_for_approval" type="object" class="btn-primary" attrs="{'invisible': [('type', '!=', 'update')]}"/>
                    <button string="Abort" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="request_approval_user_wizard_action" model="ir.actions.act_window">
        <field name="name">Request for Approval</field>
        <field name="res_model">job.costing.approvers.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="job_costing_approvers_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>