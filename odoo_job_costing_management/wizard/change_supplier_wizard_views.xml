<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="change_supplier_wizard_form" model="ir.ui.view">
        <field name="name">change.supplier.wizard.form</field>
        <field name="model">change.supplier.wizard</field>
        <field name="arch" type="xml">
            <form string="Select a Supplier">
                <sheet>
                    <group>
                        <group>
                            <field name="current_supplier_id" invisible="1"/>
                            <field name="model_id" invisible="1"/>
                            <field name="record_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="new_supplier_id"/>

                        </group>
                        <group>
                            <field name="current_supplier_product_line" nolabel="1" colspan="2" readonly="1" force_save="1">
                                <tree>
                                    <field name="current_supplier_id" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="partner_id"/>
                                    <field name="job_costing_price"/>
                                    <field name="lead_time"/>
                                    <field name="job_cost_line_id" invisible="1"/>
                                </tree>
                            </field>
                        </group>
                        <group>
                            <field name="new_supplier_product_line" nolabel="1" colspan="2" readonly="1" force_save="1">
                                <tree>
                                    <field name="new_supplier_id" invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="job_costing_price"/>
                                    <field name="lead_time"/>
                                    <field name="job_cost_line_id" invisible="1"/>
                                </tree>
                            </field>
                        </group>


                    </group>
                </sheet>
                <footer>
                    <button string='Confirm' name="change_product_supplier" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="change_supplier_wizard_action" model="ir.actions.act_window">
        <field name="name">Select Supplier</field>
        <field name="res_model">change.supplier.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="change_supplier_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>