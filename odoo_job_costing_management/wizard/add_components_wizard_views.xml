<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="add_components_wizard_form" model="ir.ui.view">
        <field name="name">add.components.wizard.form</field>
        <field name="model">add.components.wizard</field>
        <field name="arch" type="xml">
            <form string="Select a Component">
                <sheet>

                    <group>
                        <group>
                            <field name="boat_type_id" invisible="1"/>
                            <field name="bom_id" options="{'no_create': True, 'no_create_edit':True }" domain="[('boat_type_ids', 'in', boat_type_id), ('is_this_standard_bom', '=', True)]"/>
                            <field name="model_id" invisible="1"/>
                            <field name="record_id" invisible="1"/>

                        </group>
                        <group>
                             <field name="quantity" invisible="0"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string='Confirm' name="add_component" type="object" class="btn-primary"/>
                    <button string="Abort" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="add_components_wizard_action" model="ir.actions.act_window">
        <field name="name">Select Components</field>
        <field name="res_model">add.components.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="add_components_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>