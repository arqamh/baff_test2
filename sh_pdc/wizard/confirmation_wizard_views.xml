<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pdc_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">pdc.confirmation.wizard.form</field>
        <field name="model">pdc.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Approval">
                <sheet>
                    <div  class="alert alert-danger text-center" role="status">
                        <h5>
                            <field name="message" nolabel="1" readonly="1" force_save="1"/>
                        </h5>
                    </div>
                    <group>
                        <group>
                            <field name="pdc_payment_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string='Yes' name="submission" type="object" class="btn-primary"/>
                    <button string='No' name="reject_deposit"  type="object" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="pdc_confirmation_wizard_action" model="ir.actions.act_window">
        <field name="name">Confirmation</field>
        <field name="res_model">pdc.confirmation.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="pdc_confirmation_wizard_form"/>
        <field name="target">new</field>
    </record>


</odoo>