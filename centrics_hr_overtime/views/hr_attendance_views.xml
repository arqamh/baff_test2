<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">hr.attendance.tree.inherit.centrics.hr.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field name="eligible_for_overtime" invisible="1"/>
                <field name="normal_overtime" widget="float_time" invisible="1"/>
                <field name="double_overtime" widget="float_time" invisible="1"/>
                <field name="triple_overtime" widget="float_time" invisible="1"/>
                <field name="enable_inline_approval" invisible="1"/>
                <field name="overtime_approval_status" readonly="1" invisible="1"/>
            </xpath>
        </field>
    </record>




    <!-- List view for the Employee Overtime records -->
    <record id="hr_attendance_view_tree_overtime" model="ir.ui.view">
        <field name="name">hr.attendance.view.tree.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <tree string="Hr Attendance" create="false">
                <header>
                    <button type="object" name="action_recompute_overtime" string="Overtime Re-Compute"/>
                </header>
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="eligible_for_overtime" invisible="1"/>
                <field name="normal_overtime" widget="float_time"
                       attrs="{'readonly': [('overtime_approval_status', '=','approved')]}"/>
                <field name="double_overtime" widget="float_time"
                       attrs="{'readonly': [('overtime_approval_status', '=','approved')]}"/>
                <field name="triple_overtime" widget="float_time"
                       attrs="{'readonly': [('overtime_approval_status', '=','approved')]}"/>
                <field name="enable_inline_approval" invisible="1"/>
                <field name="overtime_approval_status" readonly="1"/>
                <button name="action_approve_overtime"
                        type="object"
                        icon="fa-check text-primary"
                        title="Approve Overtime"
                        attrs="{'invisible': ['|',('enable_inline_approval', '=', False),('overtime_approval_status', '=','approved')]}"
                        groups="centrics_hr_overtime.centrics_hr_overtime_group_overtime_approval"
                />
                <button name="action_reset_overtime_status"
                        type="object"
                        icon="fa-undo text-primary"
                        title="Rest Overtime"
                        attrs="{'invisible': [('overtime_approval_status', '=','pending')]}"
                        groups="centrics_hr_overtime.centrics_hr_overtime_group_overtime_approval"
                />
            </tree>
        </field>
    </record>
    
    

    <!-- Overtime list view action -->
    <record id="hr_attendance_action_overtime" model="ir.actions.act_window">
        <field name="name">Employee Overtime</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hr_attendance_view_tree_overtime"/>
        <field name="domain">[('eligible_for_overtime', '=', True)]</field>
    </record>

    <!-- Overtime List menu -->
    <menuitem
            id="hr_overtime_menu"
            name="HR Overtime"
            parent="centrics_hr_overtime.hr_overtime_rule_menu_root"
            action="hr_attendance_action_overtime"
            groups="centrics_hr_overtime_group_overtime_user,centrics_hr_overtime_group_overtime_approval"
            sequence="2"
    />

    <!-- Server Action for Bulk Approval -->
    <record id="hr_attendance_bulk_approve_action" model="ir.actions.server">
        <field name="name">Approve Overtime</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">
if env.company.enable_bulk_approval:
    action = env['hr.attendance'].browse(env.context.get('active_ids')).action_bulk_approve_overtime()
else:
    raise UserError("Your company settings do not allow bulk overtime approval.")
        </field>
        <field name="binding_view_types">tree</field>
    </record>
</odoo>