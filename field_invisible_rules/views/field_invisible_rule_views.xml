<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="field_invisible_rule__view__tree" model="ir.ui.view">
        <field name="name">field.invisible.rule.view.tree</field>
        <field name="model">field.invisible.rule</field>
        <field name="arch" type="xml">
            <tree string="Field Invisible Rules"
                  decoration-muted="active == False">
                <field name="name"/>
                <field name="model_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="field_invisible_rule__view__form" model="ir.ui.view">
        <field name="name">field.invisible.rule.view.form</field>
        <field name="model">field.invisible.rule</field>
        <field name="arch" type="xml">
            <form string="Field Invisible Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Hide internal notes after approval"/>
                        </h1>
                    </div>
                    <group>
                        <field name="model_id"
                               options="{'no_create': True}"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <separator string="Hidden Fields"/>
                    <field name="line_ids"
                           attrs="{'invisible': [('model_id', '=', False)]}">
                        <tree editable="bottom">
                            <field name="model_id" invisible="1"/>
                            <field name="trigger_field_id"
                                   options="{'no_create': True}"
                                   domain="[('model_id', '=', model_id),
                                            ('ttype', 'in', ['selection', 'char', 'text', 'html',
                                                             'boolean', 'integer', 'float',
                                                             'monetary', 'many2one'])]"/>
                            <field name="trigger_field_ttype"
                                   string="Type" optional="hide"/>
                            <field name="trigger_values"
                                   placeholder="e.g. purchase,done — or 1,5,8 for IDs / true,false for booleans"/>
                            <field name="field_id"
                                   options="{'no_create': True}"
                                   domain="[('model_id', '=', model_id), ('store', '=', True),
                                            ('compute', '=', False)]"/>
                            <field name="override_group_ids"
                                   string="Override Groups"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="field_invisible_rule__view__search" model="ir.ui.view">
        <field name="name">field.invisible.rule.view.search</field>
        <field name="model">field.invisible.rule</field>
        <field name="arch" type="xml">
            <search string="Field Invisible Rules">
                <field name="name"/>
                <field name="model_id"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Model" name="group_model"
                            context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="field_invisible_rule__action" model="ir.actions.act_window">
        <field name="name">Field Invisible Rules</field>
        <field name="res_model">field.invisible.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id"
               ref="field_invisible_rule__view__search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure per-line field hiding based on any field's value.
            </p>
            <p>
                Pick a model, then add one line per hidden field — each line
                has its own trigger field and trigger values. The form/tree
                will hide the configured fields when the trigger matches.
            </p>
        </field>
    </record>

</odoo>
