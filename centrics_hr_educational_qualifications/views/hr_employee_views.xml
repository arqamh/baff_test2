<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit Core Employee Profile Form view -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.centrics_hr_educational_qualifications</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Set invisible for the default Educational Qualifications Section-->
            <xpath expr="//field[@name='certificate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='study_field']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='study_school']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='personal_information']/group[1]/group[3]" position="attributes">
                <attribute name="string"></attribute>
            </xpath>

            <!-- Add new page for the multiple Educational Qualifications -->
            <xpath expr="//page[@name='personal_information']" position="after">
                <page name="educational_qualifications" string="Educational Qualifications" groups="hr.group_hr_user">
                    <field name="educational_qualification_line_ids">
                        <tree editable="bottom">
                            <field name="certification_level_id" reuired="1"/>
                            <field name="study_field" required="1"/>
                            <field name="school_university" required="1"/>
                            <field name="attachment_ids"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>