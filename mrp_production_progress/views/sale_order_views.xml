<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sale Order Form View - Add Manufacturing Progress -->
    <record id="sale_order_form_view_mo_progress" model="ir.ui.view">
        <field name="name">sale.order.form.mo.progress</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Add Manufacturing Progress after Other Information tab or before it -->
            <xpath expr="//page[@name='other_information']" position="before">
                <page string="Manufacturing Progress" name="manufacturing_progress"
                      attrs="{'invisible': [('has_manufacturing_orders', '=', False)]}">
                    <group>
                        <group string="Manufacturing Order Progress">
                            <field name="has_manufacturing_orders" invisible="1"/>
                            <field name="mo_component_progress" widget="progressbar"/>
                            <field name="mo_operation_progress" widget="progressbar"/>
                            <field name="mo_overall_progress" widget="progressbar"/>
                        </group>
                    </group>
                    <separator string="Manufacturing Orders"/>
                    <field name="mrp_production_ids" readonly="1">
                        <tree decoration-muted="state == 'cancel'"
                              decoration-success="state == 'done'"
                              create="0" delete="0">
                            <field name="name" string="Manufacturing Order"/>
                            <field name="product_id"/>
                            <field name="product_qty" string="Quantity"/>
                            <field name="qty_producing" string="Produced"/>
                            <field name="total_component_progress" string="Component %" widget="progressbar"/>
                            <field name="total_operation_progress" string="Operation %" widget="progressbar"/>
                            <field name="total_overall_progress" string="Overall %" widget="progressbar"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-info="state not in ('done', 'cancel')"
                                   decoration-danger="state == 'cancel'"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <!-- Alternative: Add progress section before notebook for quick view -->
            <xpath expr="//notebook" position="before">
                <div attrs="{'invisible': [('has_manufacturing_orders', '=', False)]}" class="mb-3">
                    <separator string="Manufacturing Progress"/>
                    <group>
                        <group string="Average MO Progress (incl. All Child MOs)">
                            <field name="has_manufacturing_orders" invisible="1"/>
                            <field name="mo_component_progress" widget="progressbar"/>
                            <field name="mo_operation_progress" widget="progressbar"/>
                            <field name="mo_overall_progress" widget="progressbar"/>
                        </group>
                    </group>
                </div>
            </xpath>

        </field>
    </record>

    <!-- Sale Order Tree View - Add Progress Columns -->
    <record id="sale_order_tree_view_mo_progress" model="ir.ui.view">
        <field name="name">sale.order.tree.mo.progress</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <!-- Add progress columns before state -->
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="mo_overall_progress" string="MO Progress %"
                       widget="progressbar"
                       optional="hide"
                       attrs="{'invisible': [('has_manufacturing_orders', '=', False)]}"/>
                <field name="has_manufacturing_orders" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
