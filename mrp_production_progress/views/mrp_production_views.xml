<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_progress" model="ir.ui.view">
        <field name="name">mrp.production.form.progress</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Progress bars section before notebook -->
            <xpath expr="//notebook" position="before">
                <div attrs="{'invisible': [('state', 'in', ('draft', 'cancel'))]}" class="mb-3">
                    <separator string="Progress"/>
                    <group col="2">
                        <!-- Left column: This MO -->
                        <group string="This MO">
                            <field name="component_progress" widget="progressbar"/>
                            <field name="operation_progress" widget="progressbar"/>
                            <field name="overall_progress" widget="progressbar"/>
                        </group>
                        <!-- Right column: Total (incl. Child MOs) -->
                        <group string="Total (incl. Child MOs)"
                               attrs="{'invisible': [('mrp_production_child_count', '=', 0)]}">
                            <field name="total_component_progress" widget="progressbar"/>
                            <field name="total_operation_progress" widget="progressbar"/>
                            <field name="total_overall_progress" widget="progressbar"/>
                        </group>
                    </group>
                </div>
            </xpath>

            <!-- MO Progress tab after Miscellaneous -->
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="MO Progress" name="mo_progress"
                      attrs="{'invisible': [('mrp_production_child_count', '=', 0)]}">
                    <field name="child_mo_ids" readonly="1">
                        <tree decoration-muted="state == 'cancel'"
                              decoration-success="state == 'done'"
                              create="0" delete="0" edit="0">
                            <field name="name" string="Manufacturing Order"/>
                            <field name="product_id"/>
                            <field name="product_qty" string="Qty"/>
                            <field name="qty_producing" string="Produced"/>
                            <field name="component_progress" string="Component %" widget="progressbar"/>
                            <field name="operation_progress" string="Operation %" widget="progressbar"/>
                            <field name="overall_progress" string="Overall %" widget="progressbar"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-info="state not in ('done', 'cancel')"
                                   decoration-danger="state == 'cancel'"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
