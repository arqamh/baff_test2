<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="employee_loan_stage_view_tree" model="ir.ui.view">
        <field name="name">employee.loan.stage.view.tree</field>
        <field name="model">employee.loan.stage</field>
        <field name="arch" type="xml">
            <tree string="Employee Loan Stages">
                <field name="sequence"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="allow_print"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="employee_loan_stage_view_form" model="ir.ui.view">
        <field name="name">employee.loan.stage.view.form</field>
        <field name="model">employee.loan.stage</field>
        <field name="arch" type="xml">
            <form string="Employee Loan Stage">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                        <field name="fold"/>
                        <field name="allow_print"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="employee_loan_stage_action" model="ir.actions.act_window">
        <field name="name">Employee Loan Stages</field>
        <field name="res_model">employee.loan.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_employee_loan_stage"
              name="Employee Loan Stages"
              groups="centrics_hr_loan_management.group_loan_user"
              sequence="3"
              action="employee_loan_stage_action"
              parent="centrics_hr_loan_management.loan_management_configurations"
    />
</odoo>