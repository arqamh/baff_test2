<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Tree View -->
        <record id="accounts_map_view_tree" model="ir.ui.view">
            <field name="name">accounts.map.view.tree</field>
            <field name="model">accounts.map</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="action"/>
                    <field name="journal_id"/>
                    <field name="recoverable_account_id"/>
                    <field name="payable_account_id"/>
                    <field name="interest_account_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="accounts_map_view_form" model="ir.ui.view">
            <field name="name">accounts.map.view.form</field>
            <field name="model">accounts.map</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1 class="d-flex flex-row">
                                <field name="name"
                                       style="font-size: min(4vw, 2.6rem);" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="action" required="1"/>
                                <field name="journal_id" required="1"/>
                                <field name="bank_cash_account_id" required="1"/>
                                <field name="recoverable_account_id" required="1"/>
                            </group>
                            <group>
                                <field name="payable_account_id" required="1"/>
                                <field name="interest_account_id" required="1"/>
                                <field name="is_global" required="1"/>
                                <field name="loan_type_ids" widget="many2many_tags"/>
                                <field name="company_id" required="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="accounts_map_action" model="ir.actions.act_window">
            <field name="name">Accounts Map</field>
            <field name="res_model">accounts.map</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_accounts_map"
                  name="Accounts Map"
                  parent="loan_management_configurations"
                  action="accounts_map_action"
                  sequence="4"
                  groups="centrics_hr_loan_management.group_loan_manager"
        />
    </data>
</odoo>