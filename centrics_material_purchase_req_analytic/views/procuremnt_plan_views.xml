<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!--Procurement plan form view customizations-->
    <record id="procurement_plan_view_form" model="ir.ui.view">
        <field name="name">procurement.plan.view.form.inherit.centrics_material_purchase_req_analytic</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       readonly="1"
                       force_save="1"
                />
            </field>

        </field>
    </record>

    <!--Procurement plan tree view customizations-->
    <record id="procurement_plan_view_tree" model="ir.ui.view">
        <field name="name">procurement.plan.view.tree.inherit.centrics_material_purchase_req_analytic</field>
        <field name="model">procurement.plan</field>
        <field name="inherit_id" ref="procurement_plan.view_procurement_plan_list"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="analytic_distribution"
                       widget="analytic_distribution"
                       optional="hide"
                       readonly="1"
                       force_save="1"
                />
            </field>

        </field>
    </record>

</odoo>