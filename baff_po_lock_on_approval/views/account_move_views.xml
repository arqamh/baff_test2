<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_lock_from_po" model="ir.ui.view">
        <field name="name">account.move.form.lock.from.po</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']"
                   position="before">
                <field name="po_locked" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']"
                   position="attributes">
                <attribute name="attrs">{'readonly': [('po_locked', '=', True)]}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']"
                   position="attributes">
                <attribute name="attrs">{'readonly': [('po_locked', '=', True)]}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']"
                   position="attributes">
                <attribute name="attrs">{'readonly': [('po_locked', '=', True)]}</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
