<odoo>
    <!--    Inherit Configurations setting view -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_be_hr_contract_salary</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <h2>Approval Method</h2>
                <div class="row mt16 o_settings_container" id="user_approver_method">
                    <div class="col-12 col-lg-6 o_setting_box" id="user_approver_method_setting">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="multiple_approval_method" string="Approval Method"/>
                            <div class="text-muted">
                                Select a approval Method
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="multiple_approval_method" class="o_light_label" widget="radio" options="{'horizontal': true}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>