<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--   Comment wizard and action-->
    <record id="reject_approve_comment_wizard" model="ir.ui.view">
        <field name="name">request.approve.reject.wizard.form</field>
        <field name="model">request.approve.reject.wizard</field>
        <field name="arch" type="xml">
            <form >
                <sheet>
                    <h2>Add Your Comment</h2>
                    <group>
                        <group>
                            <field name="comment" attrs="{'required': [('action_type', '=', 'reject')]}"/>
                            <field name="user_id" readonly="1" force_save="1" options="{'no_create': True, 'no_create_edit':True }"/>
                            <field name="requested_user" invisible="1"/>
                            <field name="record_id" invisible="1"/>
                            <field name="model_id" invisible="1"/>
                            <field name="action_type" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string='Submit' name="submission" type="object" class="btn-primary"/>
                    <button string="Abort" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reject_approve_comment_wizard_action" model="ir.actions.act_window">
        <field name="name">Add Your Comment</field>
        <field name="res_model">request.approve.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reject_approve_comment_wizard"/>
        <field name="target">new</field>
    </record>


</odoo>