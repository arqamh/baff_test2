<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_procurement_plan_form" model="ir.ui.view">
            <field name="name">procurement.plan.form</field>
            <field name="model">procurement.plan</field>
            <field name="arch" type="xml">
                <form string="Register Payment" edit="false">
                    <field name="state_technical" invisible="1"/>
                    <header>
                        <field name="delivery_status" invisible="1"/>
                        <button name="create_purchase_order" type="object" string="Create RFQ" class="btn btn-primary" attrs="{'invisible':[('state', 'not in', ('draft', 'rfq'))]}" context="{'is_single_order': True}"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" text="Completed"
                                bg_color="bg-success"
                                attrs="{'invisible': [('delivery_status', '!=', 'completed')]}"
                                tooltip="Delivery Status."
                        />
                        <widget name="web_ribbon" text="Partially Received"
                                bg_color="bg-info"
                                attrs="{'invisible': [('delivery_status', '!=', 'partial')]}"
                                tooltip="Delivery Status."
                        />
                        <widget name="web_ribbon" text="Pending"
                                bg_color="bg-info"
                                attrs="{'invisible': [('delivery_status', '!=', 'Pending')]}"
                                tooltip="Delivery Status."
                        />
<!--                        <widget name="web_ribbon" text="None"-->
<!--                                bg_color="bg-info"-->
<!--                                attrs="{'invisible': [('delivery_status', '!=', False)]}"-->
<!--                                tooltip="Delivery Status."-->
<!--                        />-->
                        <div class="oe_button_box" name="button_box">

                            <button name="open_related_purchase_order" type="object" string="Purchase Order"
                                    icon="fa-pencil-square-o" style="margin-right:70px"/>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_pending" invisible="1"/>
                                <field name="product_id"/>
                                <field name="source"/>
                                <field name="required_qty"/>
                                <field name="on_hand_qty" />
                                <field name="forecasted_qty"/>
                                <field name="to_order_qty"/>
                            </group>
                            <group>
                                <field name="scheduled_date"/>
                                <field name="company_id" invisible="1"/>
                                <field name="lead_time" />
                                <field name="order_last_date" />
                                <field name="ordered_qty" />
                                <field name="received_qty"/>
                                <field name="partner_id"/>
                            </group>
                        </group>

                    </sheet>
                    <div class="o_attachment_preview"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>


        <record id="view_procurement_plan_list" model="ir.ui.view">
            <field name="name">procurement.plan.tree</field>
            <field name="model">procurement.plan</field>
            <field name="arch" type="xml">
                <tree string="Procurement Plan"  create="false" editable="bottom"
                      decoration-warning="order_color_by_date == 'warning'"
                      decoration-danger="order_color_by_date == 'red'"
                      decoration-success="order_color_by_date == 'green'"
                      decoration-info="order_color_by_date == 'blue'"
                >
                    <field name="order_color_by_date" invisible="1"/>
                    <field name="is_pending" invisible="1"/>
                    <field name="partner_ids" invisible="1"/>
<!--                    <field name="date_open" eval="(DateTime.today() - relativedelta(months=1)).strftime('%Y-%m-%d %H:%M')"/>-->
                    <field name="name" readonly="1" force_save="1" string="PR Number"/>
                    <field name="product_id" readonly="1" force_save="1"/>
                    <field name="mrp_id" readonly="1" force_save="1" optional="hide"/>
                    <field name="source" readonly="1" force_save="1" optional="hide"/>
                    <field name="scheduled_date" readonly="1" force_save="1" optional="show"/>
                    <field name="required_qty" readonly="1" force_save="1" optional="show" />
                    <field name="on_hand_qty" readonly="1" force_save="1" optional="show" />
                    <field name="forecasted_qty" readonly="1" force_save="1" optional="show" />
                    <field name="actual_to_order_qty" string="Qty to Order"/>
                    <field name="to_order_qty" force_save="1" optional="show" attrs="{'readonly': [('name', '!=', False)]}" string="Qty to Purchase"/>
                    <field name="new_status"/>
                    <field name="partner_id" domain="[('id', 'in', partner_ids)]" readonly="0" force_save="1" optional="show"/>
                    <button name="action_resync_suppliers" title="Re Sync Vendors" type="object" icon="fa-retweet"/>
                    <field name="lead_time" readonly="1" force_save="1" optional="show"/>
                    <field name="requisition_id" readonly="1" force_save="1" string="MR Number"/>
                    <field name="order_last_date" readonly="1" force_save="1" optional="show"/>
                    <field name="ordered_qty" readonly="1" force_save="1" optional="show"/>
                    <field name="received_qty" readonly="1" force_save="1" optional="show"/>
                    <field name="remaining_to_order" invisible="1"/>
                    <field name="state" readonly="1" force_save="1" invisible="1" />
                    <field name="delivery_status" readonly="1" force_save="1" optional="show" string="Status" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="state_technical" invisible="1"/>
                    <field name="purchase_order_ids" widget="many2many_tags" invisible="1"/>
                    <field name="purchase_order_line_ids" widget="many2many_tags" invisible="1"/>
                    <button name="open_related_purchase_order" type="object" string="Purchase Order" attrs="{'invisible': [('purchase_order_line_ids', '=', False)]}"/>
                </tree>
            </field>
        </record>

        <record id="view_procurement_plan_search" model="ir.ui.view">
            <field name="name">procurement.plan.search</field>
            <field name="model">procurement.plan</field>
            <field name="arch" type="xml">
                <search string="Procurement Plan">
                    <field name="name" string="name" filter_domain="['|','|', '|', ('source', 'ilike', self), ('name', 'ilike', self), ('partner_id', 'ilike', self), ('product_id', 'ilike', self)]"/>
                    <field name="source" />
                    <field name="product_id" />
                    <field name="scheduled_date"/>
                    <field name="partner_id" string="Suppliers"/>
                    <separator/>
                    <filter string="Draft" name="status_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="RFQ" name="status_rfq" domain="[('state', '=', 'rfq')]"/>
                    <filter string="Purchase order Created" name="status_po" domain="[('state', '=', 'po')]"/>
                    <filter string="IN Progress" name="state_progress" domain="[('state', '=', 'progress')]"/>
                    <filter string="Completed" name="state_completed" domain="[('state', '=', 'completed')]"/>
                    <separator/>
                    <filter string="Delivery Pending" name="status_pending" domain="[('delivery_status', '=', 'pending')]"/>
                    <filter string="Partially Received" name="status_partial" domain="[('delivery_status', '=', 'partial')]"/>
                    <filter string="Pending" name="pending" domain="[('is_pending', '=', True)]"/>
                    <filter string="Completed" name="state_completed" domain="[('state', '=', 'completed')]"/>
                    <separator/>

                    <group expand="1" string="Group By">
                        <filter string="Vendor" name="group_by_partner_id" domain="[]"
                                context="{'group_by':'partner_id'}"/>
                        <filter string="Product" name="group_by_product_id" domain="[]"
                                context="{'group_by':'product_id'}"/>
                        <filter string="Scheduled Date" name="group_by_scheduled_date" domain="[]"
                                context="{'group_by':'scheduled_date'}"/>
                        <filter string="Delivery Status" name="group_by_status" domain="[]"
                                context="{'group_by':'delivery_status'}"/>
                        <filter string="Status" name="group_by_state" domain="[]"
                                context="{'group_by':'state'}"/>
                        <filter string="Pending" name="group_by_completion" domain="[]"
                                context="{'group_by':'is_pending'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_procurement_plan" model="ir.actions.act_window">
            <field name="name">Procurement Plan</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">procurement.plan</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no records
                </p>
            </field>
        </record>


        <record id="action_procurement_plan_all" model="ir.actions.act_window">
            <field name="name">Procurement Plan</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">procurement.plan</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no record
                </p>
            </field>
        </record>

<!--        <menuitem id="menuitem_procurement_plan_root"-->
<!--            name="Procurement Plan"-->
<!--            groups="access_group_procurement_plan_user"-->
<!--            web_icon="procurement_plan,static/description/menu.png"-->
<!--            sequence="145">-->
<!--            <menuitem name="Procurement Plan" id="menuitem_procurement_plan"  action="action_procurement_plan"/>-->
<!--        </menuitem>-->
        <menuitem name="Procurement Plan" sequence="1" id="menuitem_procurement_plan"  action="action_procurement_plan" groups="access_group_procurement_plan_user" parent="stock.menu_stock_root"/>

    </data>
</odoo>