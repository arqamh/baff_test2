<odoo>
    <record model="ir.module.category" id="module_procurement_plan">
        <field name="name">Procurement Plan Access</field>
        <field name="sequence">3</field>
    </record>

    <record id="group_permission_purchase_requisition" model="res.groups">
        <field name="name">Permission to Create Purchase Requisition</field>
        <field name="category_id" ref="module_procurement_plan"/>
    </record>

    <record id="group_permission_rfq" model="res.groups">
        <field name="name">Permission to Create RFQ</field>
        <field name="category_id" ref="module_procurement_plan"/>
    </record>

    <record id="access_group_procurement_plan_user" model="res.groups">
        <field name="name">Procurement Plan: User</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="category_id" ref="module_procurement_plan"/>
    </record>
</odoo>