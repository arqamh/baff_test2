<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_purchase_order_form_asset" model="ir.ui.view">
            <field name="name">purchase.order.form.asset.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <widget name="web_ribbon" title="Asset Purchase" bg_color="bg-success"
                            attrs="{'invisible': [('is_asset_purchase', '=', False)]}"/>
                </xpath>
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="custom_requisition_id" readonly="1"
                           attrs="{'invisible': [('custom_requisition_id', '=', False)]}"/>
                    <field name="is_asset_purchase"/>
                    <field name="asset_location_id"
                           attrs="{'invisible': [('is_asset_purchase', '=', False)],
                                   'required': [('is_asset_purchase', '=', True)]}"
                           options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_order_tree_asset" model="ir.ui.view">
            <field name="name">purchase.order.tree.asset.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="is_asset_purchase" string="Asset" optional="hide"/>
                    <field name="asset_location_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_rfq_tree_asset" model="ir.ui.view">
            <field name="name">purchase.rfq.tree.asset.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="before">
                    <field name="is_asset_purchase" string="Asset" optional="hide"/>
                    <field name="asset_location_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_order_search_asset" model="ir.ui.view">
            <field name="name">purchase.order.search.asset.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="asset_location_id"/>
                    <filter string="Asset Purchases" name="filter_asset_purchase"
                            domain="[('is_asset_purchase', '=', True)]"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
