<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="email_asset_purchase_po_notification" model="mail.template">
            <field name="name">Asset Purchase - RFQ/PO Created Notification</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Asset Purchase {{ object.name }} created for Requisition {{ object.custom_requisition_id.name or '' }}</field>
            <field name="email_from">{{ object.create_uid.email or object.company_id.email or user.email }}</field>
            <field name="email_to">{{ ctx.get('email_to_override') or '' }}</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:0;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background-color:#f4f4f4;">
                    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f4f4;padding:20px 0;">
                        <tr>
                            <td align="center">
                                <table width="620" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
                                    <tr>
                                        <td style="background:linear-gradient(135deg,#0b6fb8 0%,#094f87 100%);padding:24px 30px;">
                                            <h1 style="margin:0;color:#ffffff;font-size:22px;font-weight:600;">
                                                Asset Purchase - RFQ/PO Created
                                            </h1>
                                            <p style="margin:6px 0 0 0;color:#e8eef5;font-size:13px;">
                                                A new Asset Purchase order has been generated from a Material Requisition.
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:28px 30px;">
                                            <p style="margin:0 0 16px 0;color:#333;font-size:14px;line-height:1.6;">
                                                Dear Procurement Team,
                                            </p>
                                            <p style="margin:0 0 20px 0;color:#555;font-size:14px;line-height:1.6;">
                                                The following Asset Purchase order has been created and requires your attention:
                                            </p>

                                            <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8f9fa;border-radius:6px;margin-bottom:20px;">
                                                <tr>
                                                    <td style="padding:18px;">
                                                        <table width="100%" cellpadding="6" cellspacing="0">
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;width:40%;"><strong>PO / RFQ Number:</strong></td>
                                                                <td style="color:#0b6fb8;font-size:13px;font-weight:600;">
                                                                    <t t-esc="object.name"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Material Requisition:</strong></td>
                                                                <td style="color:#333;font-size:13px;">
                                                                    <t t-esc="object.custom_requisition_id.name or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Vendor:</strong></td>
                                                                <td style="color:#333;font-size:13px;">
                                                                    <t t-esc="object.partner_id.name or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Order Date:</strong></td>
                                                                <td style="color:#333;font-size:13px;">
                                                                    <t t-esc="object.date_order and object.date_order.strftime('%Y-%m-%d') or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Asset Location:</strong></td>
                                                                <td style="color:#333;font-size:13px;font-weight:600;">
                                                                    <t t-esc="object.asset_location_id.complete_name or object.asset_location_id.display_name or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Requested By:</strong></td>
                                                                <td style="color:#333;font-size:13px;">
                                                                    <t t-esc="object.custom_requisition_id.employee_id.name or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Department:</strong></td>
                                                                <td style="color:#333;font-size:13px;">
                                                                    <t t-esc="object.custom_requisition_id.department_id.name or 'N/A'"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="color:#666;font-size:13px;"><strong>Total Amount:</strong></td>
                                                                <td style="color:#333;font-size:13px;font-weight:600;">
                                                                    <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol or ''"/>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>

                                            <t t-if="object.order_line">
                                                <h3 style="margin:0 0 10px 0;color:#0b6fb8;font-size:15px;">Order Lines</h3>
                                                <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin-bottom:20px;">
                                                    <thead>
                                                        <tr style="background:#0b6fb8;color:#fff;">
                                                            <th style="padding:8px;font-size:12px;text-align:left;">Product</th>
                                                            <th style="padding:8px;font-size:12px;text-align:right;">Qty</th>
                                                            <th style="padding:8px;font-size:12px;text-align:center;">UoM</th>
                                                            <th style="padding:8px;font-size:12px;text-align:right;">Unit Price</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="object.order_line" t-as="line">
                                                            <tr style="border-bottom:1px solid #eee;">
                                                                <td style="padding:8px;font-size:12px;color:#333;">
                                                                    <t t-esc="line.product_id.display_name or line.name"/>
                                                                </td>
                                                                <td style="padding:8px;font-size:12px;color:#333;text-align:right;">
                                                                    <t t-esc="line.product_qty"/>
                                                                </td>
                                                                <td style="padding:8px;font-size:12px;color:#333;text-align:center;">
                                                                    <t t-esc="line.product_uom.name or ''"/>
                                                                </td>
                                                                <td style="padding:8px;font-size:12px;color:#333;text-align:right;">
                                                                    <t t-esc="line.price_unit"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </t>

                                            <p style="margin:16px 0 0 0;color:#333;font-size:14px;">
                                                Thank you,<br/>
                                                <t t-esc="object.env.company.name"/>
                                            </p>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="background-color:#2c3e50;padding:16px;text-align:center;color:#95a5a6;font-size:11px;">
                                            This is an automated notification from the Material Purchase Requisition module.
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
