<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

    <!-- Work entry type for "No Pay" -->
    <record id="hr_work_entry_type_no_pay" model="hr.work.entry.type">
        <field name="name">No Pay</field>
        <field name="code">NOPAY</field>
        <field name="is_leave">True</field>
    </record>

    <!-- Leave type for "No Pay" -->
    <record id="hr_leave_type_no_pay" model="hr.leave.type">
        <field name="name">No Pay</field>
        <field name="leave_validation_type">hr</field>
        <field name="requires_allocation">no</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="work_entry_type_id" ref="hr_work_entry_type_no_pay"/>
    </record>
</odoo>


