<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="grn_submit_wizard_view_form" model="ir.ui.view">
        <field name="name">grn.submit.wizard.view.form</field>
        <field name="model">grn.submit.wizard</field>
        <field name="arch" type="xml">
            <form string="Submit for Approval">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="note" nolabel="1" colspan="2"
                           class="text-muted"/>
                </group>
                <field name="approver_ids" widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <footer>
                    <button name="action_confirm_submit" type="object"
                            string="Submit" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
