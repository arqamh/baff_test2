<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="grn_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">grn.reject.wizard.view.form</field>
        <field name="model">grn.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject GRN">
                <group>
                    <field name="picking_id" readonly="1"/>
                    <field name="reason" placeholder="Explain why this GRN is being rejected (mandatory)..."/>
                    <field name="remarks" placeholder="Optional additional remarks..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object"
                            string="Reject" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
