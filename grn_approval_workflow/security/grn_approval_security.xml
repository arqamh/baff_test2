<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Category -->
        <record id="module_category_grn_approval" model="ir.module.category">
            <field name="name">GRN Approval</field>
            <field name="description">Helps you manage GRN approval workflow access rights.</field>
            <field name="sequence">25</field>
        </record>

        <!-- Approver group: users who can Approve / Reject submitted GRNs -->
        <record id="grn_approval_workflow_group_approver" model="res.groups">
            <field name="name">Approver</field>
            <field name="category_id" ref="module_category_grn_approval"/>
            <field name="comment">Members of this group can approve or reject submitted GRNs
                when no specific configuration is matched (fallback approver group).</field>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>

        <!-- Admin group: users who can manage the configuration model -->
        <record id="grn_approval_workflow_group_admin" model="res.groups">
            <field name="name">Configuration Administrator</field>
            <field name="category_id" ref="module_category_grn_approval"/>
            <field name="comment">Members of this group can configure GRN approval rules,
                approvers and email recipients.</field>
            <field name="implied_ids" eval="[(4, ref('grn_approval_workflow_group_approver'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
