<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="attendance_report_wizard_form" model="ir.ui.view">
            <field name="name">attendance.report.wizard.form</field>
            <field name="model">attendance.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="employee_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="date_to" required="1"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   attrs="{'invisible': [('employee_type', '=', 'all_employees')], 'required': [('employee_type', '=', 'specific_employee')]}"
                                   options="{'no_create': True}"/>
                            <field name="department_id"
                                   attrs="{'invisible': [('employee_type', '=', 'specific_employee')]}"
                                   options="{'no_create': True}"/>
                            <field name="company_id"
                                   attrs="{'invisible': [('employee_type', '=', 'specific_employee')]}"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <footer>
                        <button name="get_attendance_report" string="Download" type="object" class="oe_highlight"/>
                        <button string="Cancel" special="cancel" class="btn-default"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="attendance_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Attendance Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">attendance.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
                name="Reports"
                id="menu_attendance_reports"
                parent="hr_attendance.menu_hr_attendance_root"
                groups="base.group_user"
                />
        <menuitem
                name="Time Card"
                id="menu_timecard_report_wizard"
                parent="menu_attendance_reports"
                action="attendance_report_wizard_action"
                groups="base.group_user"
                />
    </data>
</odoo>
